# Application
NODE_ENV=development
PORT=3000
APP_NAME=Balai-Reserve
APP_URL=http://localhost:3000

# Session Secret (change this to a random string in production)
SESSION_SECRET=balai-reserve-super-secret-key-change-in-production

# Database Configuration
# Set USE_FIRESTORE=true to use Firebase Firestore (for Vercel deployment)
# Set USE_FIRESTORE=false or leave unset to use SQLite (for local development)
USE_FIRESTORE=false
DB_PATH=./src/database/balai_reserve.db

# Firebase Configuration (Required for Firestore and Authentication)
# Get these from Firebase Console > Project Settings > Service Accounts
FIREBASE_ADMIN_PROJECT_ID=your-project-id
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYour-Private-Key-Here\n-----END PRIVATE KEY-----\n"
FIREBASE_PROJECT_ID=your-project-id

# Upload paths
UPLOAD_PATH=./uploads
QR_PATH=./public/qrcodes

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
