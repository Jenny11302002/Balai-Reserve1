# Application
NODE_ENV=production
PORT=3000
APP_NAME=Balai-Reserve
SESSION_SECRET=your-secret-key-change-this

# Google Cloud Console web OAuth client; configure the redirect URI below there too.
# Google sign-in stays hidden until all three values are configured.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# MySQL Database (for production/Vercel)
MYSQL_HOST=your-mysql-host
MYSQL_USER=your-mysql-username
MYSQL_PASSWORD=your-mysql-password
MYSQL_DATABASE=balai_reserve
MYSQL_PORT=3306

# OR use DATABASE_URL format (Vercel/PlanetScale style)
# DATABASE_URL=mysql://user:password@host:port/database

# SQLite Database (for local development - auto-used if no MySQL config)
DB_PATH=./src/database/balai_reserve.db

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=500
