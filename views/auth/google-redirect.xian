<% layout('layouts/auth') %>

<%# This page is the redirect target after signInWithRedirect.
    Firebase calls getRedirectResult() here, gets the ID token,
    then POSTs it to /auth/google/callback for server-side verification. %>

<div class="text-center py-3">
  <div class="spinner-border text-light mb-3" style="width:2.5rem;height:2.5rem;" role="status">
    <span class="visually-hidden">Loading...</span>
  </div>
  <h5 class="text-white mb-1">Signing you in with Google…</h5>
  <p style="color:rgba(255,255,255,.55);font-size:.85rem;">Please wait, this only takes a moment.</p>
  <div id="statusMsg" style="color:rgba(255,255,255,.5);font-size:.78rem;min-height:1.5rem;"></div>
</div>

<form id="googleCallbackForm" action="/auth/google/callback" method="POST" style="display:none;">
  <input type="hidden" name="id_token" id="googleIdToken" />
</form>

<script>
(function () {
  'use strict';

  var statusEl = document.getElementById('statusMsg');

  function setStatus(msg) {
    if (statusEl) statusEl.textContent = msg;
  }

  function showError(msg) {
    document.querySelector('.spinner-border').style.display = 'none';
    document.querySelector('h5').textContent = 'Sign-in failed';
    statusEl.style.color = '#f87171';
    statusEl.textContent = msg;

    // Offer a retry link
    var retry = document.createElement('div');
    retry.className = 'mt-3';
    retry.innerHTML = '<a href="/auth/login" class="btn btn-outline-light btn-sm">' +
                      '<i class="fas fa-arrow-left me-1"></i>Back to login</a>';
    document.querySelector('.text-center').appendChild(retry);
  }

  function waitForFirebase(cb) {
    if (window.firebase && window.firebase.auth) { cb(); return; }
    var tries = 0;
    var iv = setInterval(function () {
      tries++;
      if (window.firebase && window.firebase.auth) { clearInterval(iv); cb(); return; }
      if (tries > 80) {
        clearInterval(iv);
        showError('Firebase failed to load. Check your connection and try again.');
      }
    }, 100);
  }

  waitForFirebase(function () {
    setStatus('Getting your Google account details…');

    firebase.auth().getRedirectResult()
      .then(function (result) {
        if (!result || !result.user) {
          // No redirect result — user arrived here directly, send back to login
          window.location.href = '/auth/login';
          return;
        }

        setStatus('Verifying with server…');
        return result.user.getIdToken(/* forceRefresh */ true);
      })
      .then(function (idToken) {
        if (!idToken) return;
        document.getElementById('googleIdToken').value = idToken;
        document.getElementById('googleCallbackForm').submit();
      })
      .catch(function (err) {
        console.error('getRedirectResult error:', err);
        var msg = err.code === 'auth/account-exists-with-different-credential'
          ? 'An account already exists with a different sign-in method for this email.'
          : err.message || 'Google Sign-In failed. Please try again.';
        showError(msg);
      });
  });

})();
</script>
