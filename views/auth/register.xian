<% layout('layouts/auth') %>

<% if (errors && errors.length > 0) { %>
<div class="alert alert-danger">
  <% for (const e of errors) { %>
    <div><i class="fas fa-exclamation-circle me-1"></i><%= e.msg %></div>
  <% } %>
</div>
<% } %>

<h4 class="auth-title">Create Account</h4>
<p class="auth-subtitle">Join Balai-Reserve and book your stay today</p>

<form action="/auth/register" method="POST" novalidate>
  <div class="row g-2 mb-2">
    <div class="col-6">
      <label class="form-label">First Name <span class="text-danger">*</span></label>
      <input type="text" name="first_name" class="form-control"
        value="<%= old && old.first_name ? old.first_name : '' %>"
        placeholder="Juan" required autocomplete="given-name" />
    </div>
    <div class="col-6">
      <label class="form-label">Last Name <span class="text-danger">*</span></label>
      <input type="text" name="last_name" class="form-control"
        value="<%= old && old.last_name ? old.last_name : '' %>"
        placeholder="dela Cruz" required autocomplete="family-name" />
    </div>
  </div>
  <div class="mb-2">
    <label class="form-label">Email Address <span class="text-danger">*</span></label>
    <div class="input-group">
      <span class="input-group-text"><i class="fas fa-envelope"></i></span>
      <input type="email" name="email" class="form-control"
        value="<%= old && old.email ? old.email : '' %>"
        placeholder="your@email.com" required autocomplete="email" />
    </div>
  </div>
  <div class="mb-2">
    <label class="form-label">Phone <span style="color:rgba(255,255,255,.4);font-size:.75rem;">(optional)</span></label>
    <div class="input-group">
      <span class="input-group-text"><i class="fas fa-phone"></i></span>
      <input type="text" name="phone" class="form-control"
        value="<%= old && old.phone ? old.phone : '' %>"
        placeholder="09XX-XXX-XXXX" autocomplete="tel" />
    </div>
  </div>
  <div class="mb-2">
    <label class="form-label">Password <span class="text-danger">*</span></label>
    <div class="input-group">
      <span class="input-group-text"><i class="fas fa-lock"></i></span>
      <input type="password" name="password" id="regPassword" class="form-control"
        placeholder="Minimum 8 characters" required minlength="8" autocomplete="new-password" />
      <button type="button" class="input-group-text" id="togglePass">
        <i class="fas fa-eye"></i>
      </button>
    </div>
    <div id="pwStrength" class="mt-1" style="height:4px;border-radius:2px;background:#333;overflow:hidden;">
      <div id="pwStrengthBar" style="height:100%;width:0;transition:width .3s,background .3s;"></div>
    </div>
  </div>
  <div class="mb-3">
    <label class="form-label">Confirm Password <span class="text-danger">*</span></label>
    <div class="input-group">
      <span class="input-group-text"><i class="fas fa-lock"></i></span>
      <input type="password" name="password_confirm" id="regPasswordConfirm" class="form-control"
        placeholder="Re-enter password" required autocomplete="new-password" />
    </div>
    <div id="pwMatchMsg" class="form-text" style="font-size:.72rem;"></div>
  </div>
  <div class="form-check mb-3">
    <input class="form-check-input" type="checkbox" id="agreeTerms" name="agree_terms" required />
    <label class="form-check-label" for="agreeTerms" style="font-size:.8rem;color:rgba(255,255,255,.7);">
      I agree to the
      <a href="/portal/inquire" target="_blank" style="color:#00e5ff;">Terms and Conditions</a>
      and <a href="/portal/inquire" target="_blank" style="color:#00e5ff;">Privacy Policy</a>
    </label>
  </div>
  <button type="submit" class="btn btn-primary btn-auth w-100">
    <i class="fas fa-user-plus me-2"></i>Create Account
  </button>
</form>

<div class="text-center mt-3">
  <span style="color:rgba(255,255,255,.5);font-size:.82rem;">Already have an account?</span>
  <a href="/auth/login" style="color:#00e5ff;font-size:.82rem;font-weight:600;margin-left:.35rem;">Sign in</a>
</div>

<script>
(function () {
  'use strict';
  var passInput = document.getElementById('regPassword');
  var toggleBtn = document.getElementById('togglePass');
  var bar = document.getElementById('pwStrengthBar');
  var confirmField = document.getElementById('regPasswordConfirm');
  var matchMsg = document.getElementById('pwMatchMsg');

  toggleBtn.addEventListener('click', function () {
    var icon = toggleBtn.querySelector('i');
    var showPassword = passInput.type === 'password';
    passInput.type = showPassword ? 'text' : 'password';
    icon.classList.toggle('fa-eye', !showPassword);
    icon.classList.toggle('fa-eye-slash', showPassword);
  });

  passInput.addEventListener('input', function () {
    var value = passInput.value;
    var score = 0;
    if (value.length >= 8) score++;
    if (/[A-Z]/.test(value)) score++;
    if (/[0-9]/.test(value)) score++;
    if (/[^A-Za-z0-9]/.test(value)) score++;
    bar.style.width = (score * 25) + '%';
    bar.style.background = ['', '#ef4444', '#f59e0b', '#10b981', '#10b981'][score] || '#ef4444';
  });

  function checkMatch() {
    if (!confirmField.value) {
      matchMsg.textContent = '';
    } else if (confirmField.value === passInput.value) {
      matchMsg.style.color = '#4ade80';
      matchMsg.textContent = 'Passwords match';
    } else {
      matchMsg.style.color = '#f87171';
      matchMsg.textContent = 'Passwords do not match';
    }
  }

  confirmField.addEventListener('input', checkMatch);
  passInput.addEventListener('input', checkMatch);
})();
</script>
