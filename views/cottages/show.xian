<% layout('layouts/main') %>

<div class="page-header">
  <div>
    <nav aria-label="breadcrumb"><ol class="breadcrumb mb-1">
      <li class="breadcrumb-item"><a href="/cottages">Cottages</a></li>
      <li class="breadcrumb-item active"><%= cottage.name %></li>
    </ol></nav>
    <h3 class="mb-0"><%= cottage.name %></h3>
  </div>
  <div class="page-header-actions">
    <%- statusBadge(cottage.status) %>
    <% if (currentUser && (currentUser.role === 'admin' || currentUser.role === 'staff')) { %>
    <a href="/cottages/<%= cottage.id %>/edit" class="btn btn-sm btn-outline-secondary"><i class="fas fa-edit me-1"></i>Edit</a>
    <% } %>
    <a href="/reservations/new?type=cottage" class="btn btn-sm btn-primary"><i class="fas fa-calendar-plus me-1"></i>New Reservation</a>
  </div>
</div>

<div class="row g-3">
  <div class="col-lg-4">
    <div class="card mb-3">
      <!-- Image placeholder / actual images -->
      <% if (cottage.imagesList && cottage.imagesList.length > 0) { %>
      <div id="cottageCarousel" class="carousel slide rounded-top overflow-hidden" data-bs-ride="carousel">
        <div class="carousel-inner">
          <% for (let i = 0; i < cottage.imagesList.length; i++) { %>
          <div class="carousel-item <%= i === 0 ? 'active' : '' %>">
            <img src="<%= cottage.imagesList[i] %>" class="d-block w-100 js-zoom"
              alt="Cottage photo <%= i+1 %>"
              style="height:220px;object-fit:cover;cursor:zoom-in;"
              onclick="openImgLightbox('<%= cottage.imagesList[i] %>')" />
          </div>
          <% } %>
        </div>
        <% if (cottage.imagesList.length > 1) { %>
        <button class="carousel-control-prev" type="button" data-bs-target="#cottageCarousel" data-bs-slide="prev">
          <span class="carousel-control-prev-icon"></span>
        </button>
        <button class="carousel-control-next" type="button" data-bs-target="#cottageCarousel" data-bs-slide="next">
          <span class="carousel-control-next-icon"></span>
        </button>
        <div class="carousel-indicators position-relative mt-1 d-flex gap-1 justify-content-center" style="margin:0;">
          <% for (let i = 0; i < cottage.imagesList.length; i++) { %>
          <button type="button" data-bs-target="#cottageCarousel" data-bs-slide-to="<%= i %>"
            class="<%= i===0?'active':'' %>" aria-label="Photo <%= i+1 %>"
            style="width:8px;height:8px;border-radius:50%;background:#4f46e5;border:none;opacity:<%= i===0?'1':'.4' %>"></button>
          <% } %>
        </div>
        <% } %>
      </div>
      <% } else { %>
      <div class="d-flex align-items-center justify-content-center rounded-top" style="height:180px;background:linear-gradient(135deg,#1e1b4b,#4f46e5);color:rgba(255,255,255,.3);font-size:4rem;">
        <i class="fas fa-home"></i>
      </div>
      <% } %>
      <div class="card-body">
        <table class="table table-sm table-borderless mb-0">
          <tr><th>Capacity</th><td>Up to <%= cottage.capacity %> guests</td></tr>
          <tr><th>Price</th><td class="fw-bold text-primary"><%= formatPeso(cottage.price) %></td></tr>
          <tr><th>Status</th><td><%- statusBadge(cottage.status) %></td></tr>
        </table>
        <% if (cottage.description) { %>
        <p class="text-muted small mt-3 mb-0"><%= cottage.description %></p>
        <% } %>
        <% if (cottage.amenitiesList && cottage.amenitiesList.length > 0) { %>
        <div class="mt-3">
          <strong class="small">Amenities:</strong>
          <div class="mt-1">
            <% for (const a of cottage.amenitiesList) { %>
            <span class="badge bg-light text-dark me-1 mb-1"><i class="fas fa-check text-success me-1"></i><%= a %></span>
            <% } %>
          </div>
        </div>
        <% } %>
      </div>
      <% if (currentUser && (currentUser.role === 'admin' || currentUser.role === 'staff')) { %>
      <div class="card-footer">
        <form action="/cottages/<%= cottage.id %>/status" method="POST" class="d-flex gap-2">
          <select name="status" class="form-select form-select-sm">
            <% for (const s of ['available','reserved','occupied','maintenance','unavailable']) { %>
            <option value="<%= s %>" <%= cottage.status === s ? 'selected' : '' %>><%= s.charAt(0).toUpperCase() + s.slice(1) %></option>
            <% } %>
          </select>
          <button type="submit" class="btn btn-sm btn-primary text-nowrap">Update</button>
        </form>
      </div>
      <% } %>
    </div>

    <!-- Active / Upcoming Reservation -->
    <% if (activeRes) { %>
    <div class="card border-warning">
      <div class="card-header bg-warning bg-opacity-10">
        <h6 class="card-title mb-0 text-warning small"><i class="fas fa-calendar me-1"></i>Upcoming Reservation</h6>
      </div>
      <div class="card-body py-2">
        <div class="fw-medium small"><%= activeRes.customer_name %></div>
        <div class="text-muted small"><code><%= activeRes.booking_ref %></code></div>
        <div class="text-muted small"><%= formatDate(activeRes.check_in_date) %> → <%= formatDate(activeRes.check_out_date) %></div>
        <a href="/reservations/<%= activeRes.id %>" class="btn btn-xs btn-outline-warning mt-1">View</a>
      </div>
    </div>
    <% } %>
  </div>

  <div class="col-lg-8">
    <div class="card">
      <div class="card-header"><h6 class="card-title mb-0"><i class="fas fa-history me-2"></i>Reservation History</h6></div>
      <div class="card-body p-0">
        <% if (!reservations || reservations.length === 0) { %>
        <div class="empty-state py-4"><i class="fas fa-calendar-times"></i><p>No reservation history for this cottage.</p></div>
        <% } else { %>
        <div class="table-responsive">
          <table class="table table-hover mb-0">
            <thead><tr><th>Booking Ref</th><th>Guest</th><th>Check-in</th><th>Check-out</th><th>Amount</th><th>Status</th></tr></thead>
            <tbody>
              <% for (const r of reservations) { %>
              <tr>
                <td><a href="/reservations/<%= r.id %>"><code class="small"><%= r.booking_ref %></code></a></td>
                <td class="fw-medium small"><%= r.customer_name %></td>
                <td class="small text-nowrap"><%= formatDate(r.check_in_date) %></td>
                <td class="small text-nowrap"><%= formatDate(r.check_out_date) %></td>
                <td class="small"><%= formatPeso(r.total_amount) %></td>
                <td><%- statusBadge(r.status) %></td>
              </tr>
              <% } %>
            </tbody>
          </table>
        </div>
        <% } %>
      </div>
    </div>
  </div>
</div>

<%# ── Full-image lightbox (click any photo to view it uncropped) ──────────── %>
<div id="imgLightbox" class="img-lb-overlay" onclick="closeImgLightbox()">
  <span class="img-lb-close">&times;</span>
  <img id="imgLightboxImg" src="" alt="Full image" onclick="event.stopPropagation()" />
</div>
<style>
  .img-lb-overlay { display:none; position:fixed; inset:0; z-index:10000; background:rgba(2,12,24,.94); backdrop-filter:blur(3px); align-items:center; justify-content:center; }
  .img-lb-overlay.open { display:flex; }
  .img-lb-overlay img { max-width:92vw; max-height:88vh; object-fit:contain; border-radius:.5rem; box-shadow:0 10px 40px rgba(0,0,0,.5); }
  .img-lb-close { position:fixed; top:18px; right:26px; color:#fff; font-size:2.2rem; cursor:pointer; line-height:1; }
</style>
<script>
  window.openImgLightbox = function (src) {
    var lb = document.getElementById('imgLightbox');
    document.getElementById('imgLightboxImg').src = src;
    lb.classList.add('open');
    document.body.style.overflow = 'hidden';
  };
  window.closeImgLightbox = function () {
    var lb = document.getElementById('imgLightbox');
    lb.classList.remove('open');
    document.getElementById('imgLightboxImg').src = '';
    document.body.style.overflow = '';
  };
  document.addEventListener('keydown', function (e) { if (e.key === 'Escape') closeImgLightbox(); });
</script>
