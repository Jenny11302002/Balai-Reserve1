<% layout('layouts/main') %>
<div class="page-header">
  <div><h3 class="mb-1">Sales Calls</h3><p class="text-muted mb-0">Log and track all customer sales calls</p></div>
</div>
<div class="card">
  <div class="card-body p-0">
    <div class="table-responsive">
      <table class="table table-hover mb-0">
        <thead><tr><th>Customer</th><th>Date</th><th>Purpose</th><th>Result</th><th>Staff</th><th>Follow-up</th><th>Status</th></tr></thead>
        <tbody>
          <% if (!calls || calls.length === 0) { %><tr><td colspan="7" class="text-center py-4 text-muted">No calls recorded.</td></tr>
          <% } else { %>
            <% for (const c of calls) { %>
            <tr>
              <td><a href="/crm/customers/<%= c.customer_id %>" class="fw-medium"><%= c.customer_name %></a></td>
              <td class="small"><%= formatDate(c.call_date) %><% if (c.call_time) { %> <span class="text-muted"><%= c.call_time %></span><% } %></td>
              <td><%= c.purpose %></td>
              <td class="small text-muted"><%= c.result || '—' %></td>
              <td class="small"><%= c.staff_name %></td>
              <td class="small"><%= formatDate(c.follow_up_at) || '—' %></td>
              <td><%- statusBadge(c.status) %></td>
            </tr>
            <% } %>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
  <div class="card-footer"><%include('partials/pagination')%></div>
</div>
