<% layout('layouts/main') %>
<div class="page-header">
  <div>
    <nav aria-label="breadcrumb"><ol class="breadcrumb mb-1"><li class="breadcrumb-item"><a href="/crm">Customers</a></li><li class="breadcrumb-item active"><%= customer.first_name %> <%= customer.last_name %></li></ol></nav>
    <h3 class="mb-0"><%= customer.first_name %> <%= customer.last_name %></h3>
  </div>
  <div class="page-header-actions">
    <span class="badge <%= customer.customer_type === 'vip' ? 'bg-warning text-dark' : customer.customer_type === 'corporate' ? 'bg-primary' : 'bg-light text-dark' %>"><%= customer.customer_type %></span>
    <%- statusBadge(customer.status) %>
  </div>
</div>
<div class="row g-3">
  <!-- Profile Summary -->
  <div class="col-lg-3">
    <div class="card mb-3">
      <div class="card-body text-center">
        <div class="customer-avatar-lg mb-2"><%= customer.first_name.charAt(0) %><%= customer.last_name.charAt(0) %></div>
        <div class="fw-bold"><%= customer.first_name %> <%= customer.last_name %></div>
        <div class="text-muted small mb-3"><code><%= customer.customer_code %></code></div>
        <table class="table table-sm table-borderless text-start mb-0">
          <tr><th>Email</th><td class="small"><%= customer.email || '—' %></td></tr>
          <tr><th>Phone</th><td class="small"><%= customer.phone || '—' %></td></tr>
          <tr><th>Address</th><td class="small"><%= customer.address || '—' %></td></tr>
          <tr><th>Contact</th><td class="small"><%= customer.preferred_contact %></td></tr>
          <tr><th>Total Spent</th><td class="fw-bold text-success small"><%= formatPeso(totalSpent) %></td></tr>
        </table>
        <% if (customer.notes) { %><div class="alert alert-light small mt-3 text-start mb-0"><%= customer.notes %></div><% } %>
      </div>
      <div class="card-footer">
        <a href="/reservations/new?customer_id=<%= customer.id %>" class="btn btn-sm btn-primary w-100 mb-2"><i class="fas fa-calendar-plus me-1"></i>New Reservation</a>
        <button class="btn btn-sm btn-outline-secondary w-100" data-bs-toggle="modal" data-bs-target="#editCustomerModal">Edit Profile</button>
      </div>
    </div>
  </div>

  <!-- Main Content -->
  <div class="col-lg-9">
    <!-- Nav Tabs -->
    <ul class="nav nav-tabs mb-3">
      <li class="nav-item"><a class="nav-link active" data-bs-toggle="tab" href="#tabActivity">Activity</a></li>
      <li class="nav-item"><a class="nav-link" data-bs-toggle="tab" href="#tabReservations">Reservations (<%= reservations.length %>)</a></li>
      <li class="nav-item"><a class="nav-link" data-bs-toggle="tab" href="#tabFeedback">Feedback (<%= feedback.length %>)</a></li>
      <li class="nav-item"><a class="nav-link" data-bs-toggle="tab" href="#tabCalls">Sales Calls (<%= calls.length %>)</a></li>
      <li class="nav-item"><a class="nav-link" data-bs-toggle="tab" href="#tabTickets">Tickets (<%= tickets.length %>)</a></li>
    </ul>
    <div class="tab-content">

      <!-- Activity Timeline -->
      <div class="tab-pane fade show active" id="tabActivity">
        <div class="card">
          <div class="card-header d-flex justify-content-between">
            <h6 class="card-title mb-0">Activity History</h6>
            <button class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#addActivityModal">Log Activity</button>
          </div>
          <div class="card-body">
            <% if (!activities || activities.length === 0) { %><div class="empty-state"><i class="fas fa-history"></i><p>No activities yet.</p></div>
            <% } else { %>
            <div class="timeline">
              <% for (const a of activities) { %>
              <div class="timeline-item">
                <div class="timeline-dot timeline-<%= a.activity_type %>"></div>
                <div class="timeline-content">
                  <div class="d-flex justify-content-between"><span class="fw-medium"><%= a.subject || a.activity_type %></span><span class="text-muted small"><%= formatDateTime(a.completed_at || a.created_at) %></span></div>
                  <% if (a.description) { %><div class="text-muted small"><%= a.description %></div><% } %>
                  <div class="small mt-1"><span class="badge bg-light text-dark"><%= a.activity_type %></span><% if (a.staff_name) { %> <span class="text-muted">by <%= a.staff_name %></span><% } %></div>
                  <% if (a.follow_up_at) { %><div class="small text-warning"><i class="fas fa-clock me-1"></i>Follow-up: <%= formatDate(a.follow_up_at) %></div><% } %>
                </div>
              </div>
              <% } %>
            </div>
            <% } %>
          </div>
        </div>
      </div>

      <!-- Reservations -->
      <div class="tab-pane fade" id="tabReservations">
        <div class="card">
          <div class="card-body p-0">
            <table class="table table-hover mb-0">
              <thead><tr><th>Booking Ref</th><th>Type</th><th>Date</th><th>Amount</th><th>Status</th></tr></thead>
              <tbody>
                <% if (!reservations || reservations.length === 0) { %><tr><td colspan="5" class="text-center py-4 text-muted">No reservations.</td></tr>
                <% } else { %>
                  <% for (const r of reservations) { %>
                  <tr><td><a href="/reservations/<%= r.id %>"><code class="small"><%= r.booking_ref %></code></a></td><td><span class="badge bg-light text-dark small"><%= r.reservation_type %></span></td><td class="small"><%= formatDate(r.check_in_date || r.event_date) %></td><td><%= formatPeso(r.total_amount) %></td><td><%- statusBadge(r.status) %></td></tr>
                  <% } %>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <!-- Feedback -->
      <div class="tab-pane fade" id="tabFeedback">
        <div class="card">
          <div class="card-body">
            <% if (!feedback || feedback.length === 0) { %><div class="empty-state"><i class="fas fa-star"></i><p>No feedback yet.</p></div>
            <% } else { %>
              <% for (const f of feedback) { %>
              <div class="feedback-item mb-3 pb-3 border-bottom">
                <div class="d-flex justify-content-between">
                  <div class="stars"><% for(let s=1;s<=5;s++){%><i class="fas fa-star <%= s<=f.rating ? 'text-warning' : 'text-muted' %>"></i><%}%></div>
                  <span class="text-muted small"><%= formatDate(f.created_at) %></span>
                </div>
                <div class="small mt-1"><%= f.comments || '—' %></div>
                <div class="text-muted small"><span class="badge bg-light text-dark"><%= f.category %></span> &nbsp; <a href="/reservations/<%= f.reservation_id %>"><code><%= f.booking_ref %></code></a></div>
              </div>
              <% } %>
            <% } %>
          </div>
        </div>
      </div>

      <!-- Sales Calls -->
      <div class="tab-pane fade" id="tabCalls">
        <div class="card">
          <div class="card-body p-0">
            <table class="table table-hover mb-0">
              <thead><tr><th>Date</th><th>Purpose</th><th>Result</th><th>Staff</th><th>Status</th></tr></thead>
              <tbody>
                <% if (!calls || calls.length === 0) { %><tr><td colspan="5" class="text-center py-4 text-muted">No calls recorded.</td></tr>
                <% } else { %>
                  <% for (const c of calls) { %>
                  <tr><td class="small"><%= formatDate(c.call_date) %></td><td><%= c.purpose %></td><td class="small text-muted"><%= c.result || '—' %></td><td class="small"><%= c.staff_name %></td><td><%- statusBadge(c.status) %></td></tr>
                  <% } %>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <!-- Support Tickets -->
      <div class="tab-pane fade" id="tabTickets">
        <div class="card">
          <div class="card-body p-0">
            <table class="table table-hover mb-0">
              <thead><tr><th>Ticket #</th><th>Subject</th><th>Priority</th><th>Status</th></tr></thead>
              <tbody>
                <% if (!tickets || tickets.length === 0) { %><tr><td colspan="4" class="text-center py-4 text-muted">No tickets.</td></tr>
                <% } else { %>
                  <% for (const t of tickets) { %>
                  <tr><td><a href="/crm/tickets"><code class="small"><%= t.ticket_number %></code></a></td><td><%= t.subject %></td><td><%- statusBadge(t.priority) %></td><td><%- statusBadge(t.status) %></td></tr>
                  <% } %>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>
      </div>

    </div>
  </div>
</div>

<!-- Add Activity Modal -->
<div class="modal fade" id="addActivityModal" tabindex="-1">
  <div class="modal-dialog"><div class="modal-content">
    <div class="modal-header"><h5 class="modal-title">Log Activity</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
    <form action="/crm/activities" method="POST">
      <input type="hidden" name="customer_id" value="<%= customer.id %>" />
      <div class="modal-body">
        <div class="mb-3"><label class="form-label required">Activity Type</label><select name="activity_type" class="form-select"><% for (const t of ['call','email','chat','follow_up','inquiry','complaint','support']) { %><option value="<%= t %>"><%= t.replace(/_/g,' ') %></option><% } %></select></div>
        <div class="mb-3"><label class="form-label">Subject</label><input type="text" name="subject" class="form-control" /></div>
        <div class="mb-3"><label class="form-label">Description</label><textarea name="description" class="form-control" rows="3"></textarea></div>
        <div class="mb-3"><label class="form-label">Follow-up Date</label><input type="date" name="follow_up_at" class="form-control" /></div>
      </div>
      <div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button><button type="submit" class="btn btn-primary">Log Activity</button></div>
    </form>
  </div></div>
</div>
