<% layout('layouts/main') %>
<div class="page-header">
  <div><h3 class="mb-1">Customers</h3><p class="text-muted mb-0">Centralized customer relationship management</p></div>
  <div class="page-header-actions"><a href="/crm/customers/new" class="btn btn-sm btn-primary"><i class="fas fa-plus me-1"></i>Add Customer</a></div>
</div>
<div class="card mb-3">
  <div class="card-body py-2">
    <form method="GET" action="/crm" class="row g-2 align-items-end">
      <div class="col-12 col-md-4"><input type="text" name="search" value="<%= filters.search %>" class="form-control form-control-sm" placeholder="Name, email, phone or code..." /></div>
      <div class="col-6 col-md-2"><select name="type" class="form-select form-select-sm"><option value="">All Types</option><% for (const t of types) { %><option value="<%= t %>" <%= filters.type === t ? 'selected' : '' %>><%= t %></option><% } %></select></div>
      <div class="col-6 col-md-2"><select name="status" class="form-select form-select-sm"><option value="">All Statuses</option><% for (const s of statuses) { %><option value="<%= s %>" <%= filters.status === s ? 'selected' : '' %>><%= s %></option><% } %></select></div>
      <div class="col-6 col-md-2"><button type="submit" class="btn btn-sm btn-primary w-100"><i class="fas fa-search"></i></button></div>
      <div class="col-6 col-md-2"><a href="/crm" class="btn btn-sm btn-outline-secondary w-100">Clear</a></div>
    </form>
  </div>
</div>
<div class="card">
  <div class="card-body p-0">
    <div class="table-responsive">
      <table class="table table-hover mb-0">
        <thead><tr><th>Code</th><th>Name</th><th>Email</th><th>Phone</th><th>Type</th><th>Bookings</th><th>Last Booking</th><th>Status</th><th></th></tr></thead>
        <tbody>
          <% if (!customers || customers.length === 0) { %>
          <tr><td colspan="9" class="text-center py-4 text-muted">No customers found.</td></tr>
          <% } else { %>
            <% for (const c of customers) { %>
            <tr>
              <td><code class="small"><%= c.customer_code %></code></td>
              <td><a href="/crm/customers/<%= c.id %>" class="fw-medium"><%= c.first_name %> <%= c.last_name %></a></td>
              <td class="small text-muted"><%= c.email || '—' %></td>
              <td class="small"><%= c.phone || '—' %></td>
              <td><span class="badge <%= c.customer_type === 'vip' ? 'bg-warning text-dark' : c.customer_type === 'corporate' ? 'bg-primary' : 'bg-light text-dark' %> small"><%= c.customer_type %></span></td>
              <td class="text-center"><%= c.total_bookings %></td>
              <td class="small text-muted"><%= formatDate(c.last_booking) || '—' %></td>
              <td><%- statusBadge(c.status) %></td>
              <td><a href="/crm/customers/<%= c.id %>" class="btn btn-xs btn-outline-primary">Profile</a></td>
            </tr>
            <% } %>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
  <div class="card-footer"><%include('partials/pagination')%></div>
</div>
