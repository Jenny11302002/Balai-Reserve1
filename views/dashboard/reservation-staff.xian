<% layout('layouts/main') %>

<div class="page-header">
  <div>
    <h3 class="mb-1">Reservations Dashboard</h3>
    <p class="text-muted mb-0">Good day, <%= currentUser.firstName %>! Here's your bookings overview for today.</p>
  </div>
  <div class="page-header-actions">
    <a href="/reservations/new" class="btn btn-primary btn-sm"><i class="fas fa-plus me-1"></i>New Reservation</a>
  </div>
</div>

<!-- Stats -->
<div class="row g-3 mb-4">
  <div class="col-6 col-lg-3">
    <div class="stat-card stat-warning">
      <div class="stat-icon"><i class="fas fa-clock"></i></div>
      <div class="stat-body">
        <div class="stat-value"><%= stats.pendingRes %></div>
        <div class="stat-label">Pending Reservations</div>
        <div class="stat-sub">Need attention</div>
      </div>
    </div>
  </div>
  <div class="col-6 col-lg-3">
    <div class="stat-card stat-success">
      <div class="stat-icon"><i class="fas fa-check-circle"></i></div>
      <div class="stat-body">
        <div class="stat-value"><%= stats.confirmedRes %></div>
        <div class="stat-label">Confirmed</div>
        <div class="stat-sub"><%= stats.checkedInToday %> checked in today</div>
      </div>
    </div>
  </div>
  <div class="col-6 col-lg-3">
    <div class="stat-card stat-primary">
      <div class="stat-icon"><i class="fas fa-sign-in-alt"></i></div>
      <div class="stat-body">
        <div class="stat-value"><%= stats.checkOutsToday %></div>
        <div class="stat-label">Check-outs Today</div>
        <div class="stat-sub"><%= stats.availableRooms %> rooms available</div>
      </div>
    </div>
  </div>
  <div class="col-6 col-lg-3">
    <div class="stat-card stat-danger">
      <div class="stat-icon"><i class="fas fa-money-bill-wave"></i></div>
      <div class="stat-body">
        <div class="stat-value"><%= stats.pendingPayments %></div>
        <div class="stat-label">Unpaid Balances</div>
        <div class="stat-sub"><%= stats.openInquiries %> open inquiries</div>
      </div>
    </div>
  </div>
</div>

<div class="row g-3 mb-4">
  <!-- Today's Arrivals -->
  <div class="col-lg-6">
    <div class="card">
      <div class="card-header d-flex justify-content-between align-items-center">
        <h6 class="card-title mb-0"><i class="fas fa-sign-in-alt me-2 text-success"></i>Today's Arrivals</h6>
        <span class="badge bg-success"><%= formatDate(today) %></span>
      </div>
      <div class="card-body p-0">
        <% if (!arrivals || arrivals.length === 0) { %>
        <div class="empty-state py-4"><i class="fas fa-calendar-times"></i><p>No arrivals scheduled today</p></div>
        <% } else { %>
        <div class="table-responsive">
          <table class="table table-hover mb-0">
            <thead><tr><th>Guest</th><th>Ref</th><th>Type</th><th>Status</th><th></th></tr></thead>
            <tbody>
              <% for (const r of arrivals) { %>
              <tr>
                <td><div class="fw-medium"><%= r.customer_name %></div><div class="small text-muted"><%= r.customer_phone || '' %></div></td>
                <td><code class="small"><%= r.booking_ref %></code></td>
                <td><span class="badge bg-light text-dark small"><%= r.reservation_type %></span></td>
                <td><%- statusBadge(r.status) %></td>
                <td><a href="/reservations/<%= r.id %>" class="btn btn-xs btn-outline-primary">View</a></td>
              </tr>
              <% } %>
            </tbody>
          </table>
        </div>
        <% } %>
      </div>
    </div>
  </div>

  <!-- Today's Departures -->
  <div class="col-lg-6">
    <div class="card">
      <div class="card-header d-flex justify-content-between align-items-center">
        <h6 class="card-title mb-0"><i class="fas fa-sign-out-alt me-2 text-warning"></i>Today's Departures</h6>
        <span class="badge bg-warning text-dark"><%= formatDate(today) %></span>
      </div>
      <div class="card-body p-0">
        <% if (!departures || departures.length === 0) { %>
        <div class="empty-state py-4"><i class="fas fa-calendar-times"></i><p>No departures scheduled today</p></div>
        <% } else { %>
        <div class="table-responsive">
          <table class="table table-hover mb-0">
            <thead><tr><th>Guest</th><th>Ref</th><th>Type</th><th></th></tr></thead>
            <tbody>
              <% for (const r of departures) { %>
              <tr>
                <td class="fw-medium"><%= r.customer_name %></td>
                <td><code class="small"><%= r.booking_ref %></code></td>
                <td><span class="badge bg-light text-dark small"><%= r.reservation_type %></span></td>
                <td><a href="/reservations/<%= r.id %>" class="btn btn-xs btn-outline-warning">Check-out</a></td>
              </tr>
              <% } %>
            </tbody>
          </table>
        </div>
        <% } %>
      </div>
    </div>
  </div>
</div>

<div class="row g-3">
  <!-- Pending List -->
  <div class="col-lg-7">
    <div class="card">
      <div class="card-header d-flex justify-content-between align-items-center">
        <h6 class="card-title mb-0"><i class="fas fa-hourglass-half me-2 text-warning"></i>Pending Reservations</h6>
        <a href="/reservations?status=pending" class="btn btn-sm btn-outline-warning">All Pending</a>
      </div>
      <div class="card-body p-0">
        <% if (!pendingList || pendingList.length === 0) { %>
        <div class="empty-state py-4"><i class="fas fa-check-circle text-success" style="font-size:2rem;opacity:1"></i><p class="text-success mt-2">No pending reservations!</p></div>
        <% } else { %>
        <div class="table-responsive">
          <table class="table table-hover mb-0">
            <thead><tr><th>Ref</th><th>Customer</th><th>Type</th><th>Amount</th><th>Created</th><th></th></tr></thead>
            <tbody>
              <% for (const r of pendingList) { %>
              <tr>
                <td><code class="small"><%= r.booking_ref %></code></td>
                <td class="fw-medium"><%= r.customer_name %></td>
                <td><span class="badge bg-light text-dark small"><%= r.reservation_type %></span></td>
                <td><%= formatPeso(r.total_amount) %></td>
                <td class="small text-muted"><%= formatDate(r.created_at) %></td>
                <td><a href="/reservations/<%= r.id %>" class="btn btn-xs btn-outline-primary">Process</a></td>
              </tr>
              <% } %>
            </tbody>
          </table>
        </div>
        <% } %>
      </div>
    </div>
  </div>

  <!-- Open Inquiries -->
  <div class="col-lg-5">
    <div class="card">
      <div class="card-header d-flex justify-content-between align-items-center">
        <h6 class="card-title mb-0"><i class="fas fa-question-circle me-2 text-info"></i>Open Inquiries</h6>
        <a href="/inquiries" class="btn btn-sm btn-outline-info">All Inquiries</a>
      </div>
      <div class="card-body p-0">
        <% if (!recentInquiries || recentInquiries.length === 0) { %>
        <div class="empty-state py-4"><i class="fas fa-inbox"></i><p>No open inquiries</p></div>
        <% } else { %>
          <% for (const inq of recentInquiries) { %>
          <div class="d-flex align-items-start gap-2 p-3 border-bottom">
            <div class="flex-shrink-0 mt-1">
              <span class="badge bg-light text-dark small"><%= inq.category %></span>
            </div>
            <div class="flex-grow-1 min-width-0">
              <div class="fw-medium small text-truncate"><%= inq.subject %></div>
              <div class="text-muted small"><%= inq.name || 'Anonymous' %> &middot; <%= formatDate(inq.created_at) %></div>
            </div>
            <a href="/inquiries/<%= inq.id %>" class="btn btn-xs btn-outline-primary flex-shrink-0">View</a>
          </div>
          <% } %>
        <% } %>
      </div>
    </div>
  </div>
</div>
