<% layout('layouts/main') %>
<div class="error-page text-center py-5">
  <div class="error-code text-danger">403</div>
  <h3>Access Denied</h3>
  <p class="text-muted"><%= message || 'You do not have permission to access this page.' %></p>
  <a href="/dashboard" class="btn btn-primary mt-3"><i class="fas fa-home me-1"></i>Back to Dashboard</a>
</div>
