<% layout('layouts/main') %>
<div class="error-page text-center py-5">
  <div class="error-code text-warning">429</div>
  <h3>Too Many Requests</h3>
  <p class="text-muted"><%= message || 'You have made too many requests. Please wait a moment and try again.' %></p>
  <a href="/dashboard" class="btn btn-primary mt-3"><i class="fas fa-home me-1"></i>Back to Dashboard</a>
</div>
