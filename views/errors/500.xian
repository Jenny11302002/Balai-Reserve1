<% layout('layouts/main') %>
<div class="error-page text-center py-5">
  <div class="error-code text-warning">500</div>
  <h3>Something Went Wrong</h3>
  <p class="text-muted"><%= message || 'An unexpected error occurred. Please try again.' %></p>
  <a href="/dashboard" class="btn btn-primary mt-3"><i class="fas fa-home me-1"></i>Back to Dashboard</a>
</div>
