<% layout('layouts/main') %>
<div class="page-header">
  <div>
    <nav aria-label="breadcrumb"><ol class="breadcrumb mb-1"><li class="breadcrumb-item"><a href="/events">Events</a></li><li class="breadcrumb-item active"><%= event.event_name %></li></ol></nav>
    <h3 class="mb-0"><%= event.event_name %></h3>
  </div>
  <div class="page-header-actions">
    <%- statusBadge(event.status) %>
    <% if (currentUser && (currentUser.role === 'admin' || currentUser.role === 'staff')) { %>
    <form action="/events/<%= event.id %>/status" method="POST" class="d-inline-flex gap-2">
      <select name="status" class="form-select form-select-sm"><% for (const s of ['pending','confirmed','in_progress','completed','cancelled']) { %><option value="<%= s %>" <%= event.status === s ? 'selected' : '' %>><%= s %></option><% } %></select>
      <button type="submit" class="btn btn-sm btn-primary">Update</button>
    </form>
    <% } %>
  </div>
</div>
<div class="row g-3">
  <div class="col-lg-5">
    <div class="card">
      <div class="card-body">
        <h6 class="mb-3">Event Details</h6>
        <table class="table table-sm table-borderless mb-0">
          <tr><th>Customer</th><td><a href="/crm/customers/<%= event.customer_id %>"><%= event.customer_name %></a></td></tr>
          <tr><th>Phone</th><td><%= event.customer_phone || '—' %></td></tr>
          <tr><th>Event Type</th><td><%= event.event_type.replace(/_/g,' ') %></td></tr>
          <tr><th>Date</th><td><%= formatDate(event.event_date) %></td></tr>
          <tr><th>Time</th><td><%= event.start_time %> – <%= event.end_time %></td></tr>
          <tr><th>Venue</th><td><%= event.venue_name || '—' %></td></tr>
          <tr><th>Package</th><td><%= event.package_name || '—' %></td></tr>
          <tr><th>Attendees</th><td><%= event.num_attendees %></td></tr>
          <tr><th>Total Cost</th><td class="fw-bold text-primary"><%= formatPeso(event.total_cost) %></td></tr>
          <tr><th>Payment</th><td><%- statusBadge(event.payment_status) %></td></tr>
        </table>
        <% if (event.special_requests) { %>
        <div class="alert alert-info mt-3 py-2 small"><i class="fas fa-sticky-note me-1"></i><%= event.special_requests %></div>
        <% } %>
      </div>
    </div>
  </div>
  <div class="col-lg-7">
    <div class="card">
      <div class="card-header"><h6 class="card-title mb-0"><i class="fas fa-tools me-2"></i>Equipment Assignments</h6></div>
      <div class="card-body p-0">
        <% if (!assignments || assignments.length === 0) { %>
        <div class="empty-state py-4"><i class="fas fa-toolbox"></i><p>No equipment assigned yet.</p></div>
        <% } else { %>
        <table class="table table-sm mb-0">
          <thead><tr><th>Equipment</th><th>Qty</th><th>Assigned</th><th>Expected Return</th><th>Status</th></tr></thead>
          <tbody>
            <% for (const a of assignments) { %>
            <tr>
              <td><%= a.equipment_name %></td>
              <td><%= a.quantity %></td>
              <td class="small"><%= formatDate(a.date_assigned) %></td>
              <td class="small"><%= formatDate(a.expected_return) || '—' %></td>
              <td><%- statusBadge(a.status) %></td>
            </tr>
            <% } %>
          </tbody>
        </table>
        <% } %>
      </div>
    </div>
  </div>
</div>
