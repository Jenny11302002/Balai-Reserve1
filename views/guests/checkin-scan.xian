<% layout('layouts/minimal') %>
<div class="row justify-content-center">
  <div class="col-md-6 col-lg-5">
    <div class="card shadow text-center">
      <div class="card-body p-4">
        <div class="mb-3"><i class="fas fa-qrcode fa-3x text-primary"></i></div>
        <h4>QR Check-in</h4>
        <p class="text-muted">Booking reference: <strong><%= reservation.booking_ref %></strong></p>
        <div class="alert alert-info">
          <strong><%= reservation.first_name %> <%= reservation.last_name %></strong><br />
          <small><%= reservation.phone %></small>
        </div>
        <form action="/checkin/<%= token %>" method="POST">
          <button type="submit" class="btn btn-success btn-lg w-100">
            <i class="fas fa-check me-2"></i>Confirm Check-in
          </button>
        </form>
        <div class="mt-3"><a href="/reservations/<%= reservation.id %>" class="btn btn-outline-secondary btn-sm">View Reservation Details</a></div>
      </div>
    </div>
  </div>
</div>
