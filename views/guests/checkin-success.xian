<% layout('layouts/minimal') %>
<div class="row justify-content-center">
  <div class="col-md-6 col-lg-5">
    <div class="card shadow text-center">
      <div class="card-body p-5">
        <div class="mb-3 text-success"><i class="fas fa-check-circle fa-4x"></i></div>
        <h3 class="text-success">Check-in Successful!</h3>
        <p class="text-muted">Welcome to Balai-Reserve. Your check-in has been recorded. Enjoy your stay!</p>
      </div>
    </div>
  </div>
</div>
