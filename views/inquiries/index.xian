<% layout('layouts/main') %>
<div class="page-header">
  <div><h3 class="mb-1">Inquiries</h3><p class="text-muted mb-0">Manage customer inquiries and automated responses</p></div>
</div>

<%# ── Status summary strip — shows count per status so staff understand where the badge number comes from %>
<div class="row g-2 mb-3">
  <% const statusColors = { open:'danger', in_progress:'warning', escalated:'primary', resolved:'success', closed:'secondary' }; %>
  <% for (const [s, label] of [['open','Open'],['in_progress','In Progress'],['escalated','Escalated'],['resolved','Resolved'],['closed','Closed']]) { %>
  <div class="col">
    <a href="/inquiries?status=<%= s %>" class="text-decoration-none">
      <div class="card text-center py-2 px-1 h-100 border-<%= statusColors[s] || 'secondary' %> <%= filters.status === s ? 'bg-' + (statusColors[s]||'secondary') + ' bg-opacity-10' : '' %>">
        <div class="fw-bold fs-5 text-<%= statusColors[s] || 'secondary' %>"><%= statusCounts[s] || 0 %></div>
        <div class="small text-muted"><%= label %></div>
      </div>
    </a>
  </div>
  <% } %>
</div>

<div class="card mb-3"><div class="card-body py-2">
  <form method="GET" action="/inquiries" class="row g-2 align-items-end">
    <div class="col-12 col-md-4"><input type="text" name="search" value="<%= filters.search %>" class="form-control form-control-sm" placeholder="Subject, name, or email..." /></div>
    <div class="col-6 col-md-2"><select name="status" class="form-select form-select-sm"><option value="">All Statuses</option><% for (const s of statuses) { %><option value="<%= s %>" <%= filters.status === s ? 'selected' : '' %>><%= s.replace(/_/g,' ').replace(/\b\w/g,l=>l.toUpperCase()) %></option><% } %></select></div>
    <div class="col-6 col-md-2"><select name="category" class="form-select form-select-sm"><option value="">All Categories</option><% for (const c of categories) { %><option value="<%= c %>" <%= filters.category === c ? 'selected' : '' %>><%= c %></option><% } %></select></div>
    <div class="col-3 col-md-2"><button type="submit" class="btn btn-sm btn-primary w-100"><i class="fas fa-search"></i></button></div>
    <div class="col-3 col-md-2"><a href="/inquiries" class="btn btn-sm btn-outline-secondary w-100">Clear</a></div>
  </form>
</div></div>
<div class="card">
  <div class="card-body p-0">
    <div class="table-responsive">
      <table class="table table-hover mb-0">
        <thead><tr><th>#</th><th>From</th><th>Subject</th><th>Category</th><th>Source</th><th>Assigned To</th><th>Status</th><th>Date</th><th></th></tr></thead>
        <tbody>
          <% if (!inquiries || inquiries.length === 0) { %><tr><td colspan="9" class="text-center py-4 text-muted">No inquiries found.</td></tr>
          <% } else { %>
            <% for (const inq of inquiries) { %>
            <tr>
              <td class="text-muted small">#<%= inq.id %></td>
              <td><div class="fw-medium"><%= inq.name || '—' %></div><div class="text-muted small"><%= inq.email || '' %></div></td>
              <td><a href="/inquiries/<%= inq.id %>"><%= inq.subject %></a></td>
              <td><span class="badge bg-light text-dark small"><%= inq.category %></span></td>
              <td><span class="badge bg-light text-dark small"><%= inq.source %></span></td>
              <td class="small"><%= inq.assigned_name || '—' %></td>
              <td><%- statusBadge(inq.status) %></td>
              <td class="small text-muted"><%= formatDate(inq.created_at) %></td>
              <td><a href="/inquiries/<%= inq.id %>" class="btn btn-xs btn-outline-primary">View</a></td>
            </tr>
            <% } %>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
  <div class="card-footer"><%include('partials/pagination')%></div>
</div>
