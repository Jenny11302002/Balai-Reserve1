<% layout('layouts/main') %>
<div class="page-header">
  <div><nav aria-label="breadcrumb"><ol class="breadcrumb mb-1"><li class="breadcrumb-item"><a href="/inquiries">Inquiries</a></li><li class="breadcrumb-item active">#<%= inquiry.id %></li></ol></nav><h3 class="mb-0">Inquiry #<%= inquiry.id %></h3></div>
  <div class="page-header-actions"><%- statusBadge(inquiry.status) %></div>
</div>
<div class="row g-3">
  <div class="col-lg-8">
    <div class="card mb-3">
      <div class="card-header"><h6 class="card-title mb-0">Inquiry Details</h6></div>
      <div class="card-body">
        <h5><%= inquiry.subject %></h5>
        <div class="d-flex gap-3 mb-3 flex-wrap">
          <span><strong>From:</strong> <%= inquiry.name || '—' %></span>
          <span><strong>Email:</strong> <%= inquiry.email || '—' %></span>
          <span><strong>Phone:</strong> <%= inquiry.phone || '—' %></span>
          <span><strong>Date:</strong> <%= formatDateTime(inquiry.created_at) %></span>
        </div>
        <div class="d-flex gap-2 mb-3">
          <span class="badge bg-light text-dark"><%= inquiry.category %></span>
          <span class="badge bg-light text-dark"><%= inquiry.source %></span>
        </div>
        <div class="p-3 bg-light rounded"><%= inquiry.message %></div>
        <% if (inquiry.resolution) { %>
        <div class="mt-3"><strong>Resolution:</strong><div class="p-3 bg-success bg-opacity-10 rounded mt-1"><%= inquiry.resolution %></div></div>
        <% } %>
        <% if (ticket) { %>
        <div class="alert alert-info mt-3 py-2 small"><i class="fas fa-ticket-alt me-1"></i>Escalated to support ticket <strong><%= ticket.ticket_number %></strong> &mdash; Status: <%= ticket.status %></div>
        <% } %>
      </div>
    </div>
  </div>
  <div class="col-lg-4">
    <div class="card mb-3">
      <div class="card-header"><h6 class="card-title mb-0">Inquiry Info</h6></div>
      <div class="card-body">
        <table class="table table-sm table-borderless mb-0">
          <tr><th>Status</th><td><%- statusBadge(inquiry.status) %></td></tr>
          <tr><th>Category</th><td><span class="badge bg-light text-dark"><%= inquiry.category %></span></td></tr>
          <tr><th>Source</th><td><span class="badge bg-light text-dark"><%= inquiry.source %></span></td></tr>
          <tr><th>Submitted</th><td class="small text-muted"><%= formatDateTime(inquiry.created_at) %></td></tr>
          <% if (inquiry.assigned_name) { %>
          <tr><th>Handled by</th><td class="small fw-medium"><%= inquiry.assigned_name %></td></tr>
          <% } %>
          <% if (inquiry.resolved_at) { %>
          <tr><th>Resolved</th><td class="small text-muted"><%= formatDateTime(inquiry.resolved_at) %></td></tr>
          <% } %>
        </table>
      </div>
    </div>
    <% if (inquiry.status !== 'resolved' && inquiry.status !== 'closed') { %>
    <div class="card mb-3">
      <div class="card-header"><h6 class="card-title mb-0">Resolve Inquiry</h6></div>
      <div class="card-body">
        <form action="/inquiries/<%= inquiry.id %>/resolve" method="POST">
          <div class="mb-2"><textarea name="resolution" class="form-control form-control-sm" rows="3" placeholder="Write resolution or answer..." required></textarea></div>
          <button type="submit" class="btn btn-sm btn-success w-100"><i class="fas fa-check me-1"></i>Mark as Resolved</button>
        </form>
      </div>
    </div>
    <div class="card">
      <div class="card-header"><h6 class="card-title mb-0">Escalate to Ticket</h6></div>
      <div class="card-body">
        <p class="text-muted small">Create a support ticket for this inquiry for further tracking.</p>
        <form action="/inquiries/<%= inquiry.id %>/escalate" method="POST">
          <button type="submit" class="btn btn-sm btn-warning w-100"><i class="fas fa-arrow-up me-1"></i>Escalate to Support Ticket</button>
        </form>
      </div>
    </div>
    <% } %>
  </div>
</div>
