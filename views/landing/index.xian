<%# Landing page â€” layout is set by the route handler in app.js %>
<nav class="landing-nav" id="topNav">
  <a href="/" class="nav-brand">
    <div class="nav-logo-icon"><i class="fas fa-home"></i></div>
    <div>
      <div class="nav-brand-text">Balai-Reserve</div>
      <span class="nav-brand-sub">Gloria, Oriental Mindoro</span>
    </div>
  </a>

  <div class="nav-links">
    <a href="#about">About</a>
    <a href="#accommodations">Accommodations</a>
    <a href="#events">Events</a>
    <a href="#amenities">Amenities</a>
    <a href="#how-to-book">How to Book</a>
    <a href="#contact">Contact</a>
  </div>

  <div class="nav-actions">
    <% if (currentUser) { %>
      <%# Logged-in user: show role-appropriate links %>
      <% if (currentUser.role === 'customer') { %>
        <a href="/portal/my-reservations" class="btn-outline-white btn-sm d-none d-md-inline-block" style="padding:.45rem 1.25rem;font-size:.82rem;">
          <i class="fas fa-calendar-check me-1"></i>My Bookings
        </a>
        <a href="/portal/book" class="btn-gold" style="padding:.45rem 1.5rem;font-size:.88rem;">
          <i class="fas fa-calendar-plus me-1"></i>Book Now
        </a>
      <% } else { %>
        <%# Staff user: show dashboard link %>
        <a href="/dashboard" class="btn-gold" style="padding:.45rem 1.5rem;font-size:.88rem;">
          <i class="fas fa-tachometer-alt me-1"></i>Dashboard
        </a>
      <% } %>
    <% } else { %>
      <%# Guest: show browse + sign in %>
      <a href="/portal/rooms" class="btn-outline-white btn-sm d-none d-md-inline-block" style="padding:.45rem 1.25rem;font-size:.82rem;">Browse</a>
      <a href="/auth/login"   class="btn-gold" style="padding:.45rem 1.5rem;font-size:.88rem;">
        <i class="fas fa-sign-in-alt me-1"></i>Sign In
      </a>
    <% } %>
  </div>

  <button class="nav-toggle" id="navToggle" aria-label="Open menu">
    <i class="fas fa-bars"></i>
  </button>
</nav>

<%# Mobile Nav Drawer %>
<div class="mobile-menu" id="mobileMenu">
  <button class="mobile-close" id="menuClose"><i class="fas fa-times"></i></button>
  <a href="#about"          onclick="closeMobileMenu()">About</a>
  <a href="#accommodations" onclick="closeMobileMenu()">Accommodations</a>
  <a href="#events"         onclick="closeMobileMenu()">Events</a>
  <a href="#amenities"      onclick="closeMobileMenu()">Amenities</a>
  <a href="#how-to-book"    onclick="closeMobileMenu()">How to Book</a>
  <a href="#contact"        onclick="closeMobileMenu()">Contact</a>
  <div class="mt-3 d-flex flex-column gap-3">
    <% if (currentUser) { %>
      <% if (currentUser.role === 'customer') { %>
        <a href="/portal/my-reservations" class="btn-outline-white text-center">My Bookings</a>
        <a href="/portal/book" class="btn-gold text-center"><i class="fas fa-calendar-plus me-1"></i>Book Now</a>
      <% } else { %>
        <a href="/dashboard" class="btn-gold text-center"><i class="fas fa-tachometer-alt me-1"></i>Dashboard</a>
      <% } %>
    <% } else { %>
      <a href="/portal/rooms" class="btn-outline-white text-center">Browse Accommodations</a>
      <a href="/auth/login"   class="btn-gold text-center"><i class="fas fa-sign-in-alt me-1"></i>Sign In</a>
    <% } %>
  </div>
</div>

<%# â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• %>
<%# â”€â”€ HERO SECTION â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ %>
<%# â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• %>
<section class="hero" id="home">
  <div class="hero-bg"></div>
  <div class="hero-overlay"></div>

  <%# Floating particles %>
  <div class="hero-particles">
    <span></span><span></span><span></span><span></span><span></span>
    <span></span><span></span><span></span><span></span><span></span>
  </div>

  <div class="hero-content">
    <div class="container-lp">
      <div class="row align-items-center g-5">

        <%# Left column - copy %>
        <div class="col-lg-6">
          <div class="hero-eyebrow">
            <i class="fas fa-map-marker-alt"></i>
            Brgy. San Antonio, Gloria, Oriental Mindoro, Philippines
          </div>
          <h1 class="hero-title">
            Your <span>Home Away</span><br />From Home
          </h1>
          <p class="hero-desc">
            Balai-Reserve is a premier resort destination offering comfortable rooms,
            elegant event venues, cozy cottages, and a full suite of event management
            services &mdash; all in Gloria, Oriental Mindoro.
          </p>
          <div class="hero-actions">
            <a href="/portal/rooms" class="btn-gold">
              <i class="fas fa-search me-2"></i>Browse Accommodations
            </a>
            <a href="/portal/book" class="btn-outline-white">
              <i class="fas fa-calendar-plus me-2"></i>Book Now
            </a>
          </div>
          <div class="hero-stats">
            <div class="hero-stat-pill">
              <div>
                <div class="hero-stat-val"><%= stats.totalRooms %>+</div>
                <div class="hero-stat-lbl">Rooms</div>
              </div>
            </div>
            <div class="hero-stat-pill">
              <div>
                <div class="hero-stat-val"><%= stats.totalVenues %>+</div>
                <div class="hero-stat-lbl">Venues</div>
              </div>
            </div>
            <div class="hero-stat-pill">
              <div>
                <div class="hero-stat-val"><%= stats.totalPackages %>+</div>
                <div class="hero-stat-lbl">Packages</div>
              </div>
            </div>
            <div class="hero-stat-pill">
              <div>
                <div class="hero-stat-val"><%= stats.avgRating || '4.5' %>&#9733;</div>
                <div class="hero-stat-lbl">Rating</div>
              </div>
            </div>
          </div>
        </div>

        <%# Right column - glass booking widget %>
        <div class="col-lg-6 d-none d-lg-block">
          <div class="hero-glass-card">
            <div class="glass-card-title">
              <i class="fas fa-calendar-check"></i>
              Quick Check Availability
            </div>
            <form action="/portal/rooms" method="GET">
              <div class="mb-3">
                <label class="d-block mb-1">Type</label>
                <select name="type_redirect" class="form-select" id="heroType">
                  <option value="rooms">Room Stay</option>
                  <option value="venues">Venue / Event</option>
                  <option value="cottages">Cottage</option>
                </select>
              </div>
              <div class="row g-3 mb-3">
                <div class="col-6">
                  <label class="d-block mb-1">Check-in</label>
                  <input type="date" name="checkin" class="form-control" id="heroCheckin" />
                </div>
                <div class="col-6">
                  <label class="d-block mb-1">Check-out</label>
                  <input type="date" name="checkout" class="form-control" id="heroCheckout" />
                </div>
              </div>
              <div class="mb-3">
                <label class="d-block mb-1">Guests</label>
                <input type="number" name="guests" class="form-control" min="1" value="2" />
              </div>
              <button type="submit" class="glass-submit-btn" id="heroSearchBtn">
                <i class="fas fa-search"></i> Check Availability
              </button>
            </form>
            <p class="glass-footer-note">
              Free cancellation &middot; No booking fees &middot; Instant confirmation
            </p>
          </div>
        </div>

      </div>
    </div>
  </div>
</section>

<%# â”€â”€ STATS BAR â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ %>
<div class="stats-bar">
  <div class="container-lp">
    <div class="row g-3 text-center">
      <div class="col-6 col-md-3">
        <div class="stat-number"><%= stats.totalRooms %></div>
        <div class="stat-label">Room Types</div>
      </div>
      <div class="col-6 col-md-3">
        <div class="stat-number"><%= stats.totalVenues %></div>
        <div class="stat-label">Event Venues</div>
      </div>
      <div class="col-6 col-md-3">
        <div class="stat-number"><%= stats.totalCottages %></div>
        <div class="stat-label">Cottages</div>
      </div>
      <div class="col-6 col-md-3">
        <div class="stat-number"><%= stats.totalPackages %></div>
        <div class="stat-label">Event Packages</div>
      </div>
    </div>
  </div>
</div>

<%# â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• %>
<%# â”€â”€ ABOUT SECTION â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ %>
<%# â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• %>
<section id="about">
  <div class="container-lp">
    <div class="row align-items-center g-5">
      <div class="col-lg-6">
        <div class="about-img-wrap">
          <div class="about-img-placeholder">
            <i class="fas fa-home"></i>
          </div>
          <div class="about-img-badge">
            <i class="fas fa-map-marker-alt me-1"></i>Gloria, Oriental Mindoro
          </div>
        </div>
      </div>
      <div class="col-lg-6">
        <div class="section-tag">About Balai-Reserve</div>
        <h2 class="section-title" style="text-align:left;">
          A Resort That Feels Like Home
        </h2>
        <p style="color:var(--text-muted);margin-bottom:1.75rem;font-size:.95rem;">
          Balai-Reserve is a full-service resort and event venue nestled in Gloria, Oriental Mindoro.
          Whether you're planning a quiet family weekend, a grand wedding, a corporate gathering,
          or simply looking for a peaceful getaway, Balai-Reserve is the place to be.
        </p>
        <div class="about-feature">
          <div class="about-feature-icon"><i class="fas fa-bed"></i></div>
          <div>
            <div class="about-feature-title">Comfortable Accommodations</div>
            <div class="about-feature-text">Standard, Deluxe, Suite, and Family rooms â€” all air-conditioned with modern amenities, free WiFi, and daily housekeeping.</div>
          </div>
        </div>
        <div class="about-feature">
          <div class="about-feature-icon"><i class="fas fa-star"></i></div>
          <div>
            <div class="about-feature-title">World-Class Event Spaces</div>
            <div class="about-feature-text">From intimate garden gatherings to grand receptions for 300 guests â€” our venues can handle any celebration in style.</div>
          </div>
        </div>
        <div class="about-feature">
          <div class="about-feature-icon"><i class="fas fa-leaf"></i></div>
          <div>
            <div class="about-feature-title">Nature-Inspired Cottages</div>
            <div class="about-feature-text">Our nipa hut and bamboo cottages provide a serene, nature-immersed retreat perfect for family bonding and relaxation.</div>
          </div>
        </div>
        <div class="d-flex gap-3 mt-3">
          <a href="/portal" class="btn-brand"><i class="fas fa-compass me-2"></i>Explore Resort</a>
          <a href="#contact" class="about-cta-outline">
            <i class="fas fa-phone me-2"></i>Contact Us
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<%# â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• %>
<%# â”€â”€ ACCOMMODATIONS SECTION â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ %>
<%# â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• %>
<section id="accommodations" class="bg-off">
  <div class="container-lp">
    <div class="text-center mb-5">
      <div class="section-tag">Accommodations</div>
      <h2 class="section-title">Rooms, Venues & Cottages</h2>
      <p class="section-sub">Choose from a variety of accommodation types designed for every kind of visit â€” from a quick getaway to a multi-day celebration.</p>
    </div>

    <%# Room Types overview %>
    <h5 class="accom-section-heading">
      <i class="fas fa-bed me-2 text-brand"></i>Room Types
    </h5>
    <div class="accom-grid mb-5">
      <% for (const r of featuredRooms) { %>
      <%
        let imgs = [];
        try { imgs = JSON.parse(r.images || '[]'); } catch {}
      %>
      <div class="accom-card">
        <div class="accom-img">
          <% if (imgs.length > 0) { %>
          <img src="<%= imgs[0] %>" alt="<%= r.name %>" loading="lazy" />
          <% } else { %>
          <div class="accom-img-placeholder"><i class="fas fa-bed"></i></div>
          <% } %>
          <div class="accom-img-badge"><%= r.type_name %></div>
        </div>
        <div class="accom-body">
          <div class="accom-type"><%= r.type_name %></div>
          <div class="accom-name"><%= r.name %></div>
          <div class="accom-meta">
            <i class="fas fa-users me-1"></i>Up to <%= r.capacity %> guests
            <% if (r.floor) { %>&nbsp;&middot;&nbsp;<%= r.floor %><% } %>
          </div>
          <div class="accom-price-row">
            <div class="accom-price"><%= formatPeso(r.price) %><small>/night</small></div>
            <a href="/portal/book?type=room&item_id=<%= r.id %>" class="btn-brand" style="padding:.4rem 1rem;font-size:.8rem;border-radius:6px;">Book</a>
          </div>
        </div>
      </div>
      <% } %>
    </div>

    <%# Venues overview %>
    <h5 class="accom-section-heading">
      <i class="fas fa-map-marker-alt me-2 text-brand"></i>Event Venues
    </h5>
    <div class="accom-grid mb-5">
      <% for (const v of featuredVenues) { %>
      <%
        let vImgs = [];
        try { vImgs = JSON.parse(v.images || '[]'); } catch {}
      %>
      <div class="accom-card">
        <div class="accom-img">
          <% if (vImgs.length > 0) { %>
          <img src="<%= vImgs[0] %>" alt="<%= v.name %>" loading="lazy" />
          <% } else { %>
          <div class="accom-img-placeholder"><i class="fas fa-map-marker-alt"></i></div>
          <% } %>
          <div class="accom-img-badge"><%= v.venue_type.replace(/_/g,' ') %></div>
        </div>
        <div class="accom-body">
          <div class="accom-type">Venue</div>
          <div class="accom-name"><%= v.name %></div>
          <div class="accom-meta">
            <i class="fas fa-users me-1"></i>Up to <%= v.capacity %>
            <% if (v.location) { %>&nbsp;&middot;&nbsp;<%= v.location %><% } %>
          </div>
          <div class="accom-price-row">
            <div class="accom-price"><%= formatPeso(v.price) %></div>
            <a href="/portal/book?type=venue&item_id=<%= v.id %>" class="btn-brand" style="padding:.4rem 1rem;font-size:.8rem;border-radius:6px;">Book</a>
          </div>
        </div>
      </div>
      <% } %>
    </div>

    <%# Cottages overview %>
    <% if (featuredCottages && featuredCottages.length > 0) { %>
    <h5 class="accom-section-heading">
      <i class="fas fa-home me-2 text-brand"></i>Cottages
    </h5>
    <div class="accom-grid mb-4">
      <% for (const c of featuredCottages) { %>
      <%
        let cImgs = [];
        try { cImgs = JSON.parse(c.images || '[]'); } catch {}
      %>
      <div class="accom-card">
        <div class="accom-img">
          <% if (cImgs.length > 0) { %>
          <img src="<%= cImgs[0] %>" alt="<%= c.name %>" loading="lazy" />
          <% } else { %>
          <div class="accom-img-placeholder"><i class="fas fa-home"></i></div>
          <% } %>
          <div class="accom-img-badge">Cottage</div>
        </div>
        <div class="accom-body">
          <div class="accom-type">Cottage</div>
          <div class="accom-name"><%= c.name %></div>
          <div class="accom-meta"><i class="fas fa-users me-1"></i>Up to <%= c.capacity %> guests</div>
          <div class="accom-price-row">
            <div class="accom-price"><%= formatPeso(c.price) %></div>
            <a href="/portal/book?type=cottage&item_id=<%= c.id %>" class="btn-brand" style="padding:.4rem 1rem;font-size:.8rem;border-radius:6px;">Book</a>
          </div>
        </div>
      </div>
      <% } %>
    </div>
    <% } %>

    <div class="text-center">
      <a href="/portal/rooms" class="btn-brand me-3"><i class="fas fa-search me-2"></i>Browse All Rooms</a>
      <a href="/portal/venues" class="btn-gold"><i class="fas fa-map-marker-alt me-2"></i>Browse All Venues</a>
    </div>
  </div>
</section>

<%# â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• %>
<%# â”€â”€ EVENTS SECTION â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ %>
<%# â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• %>
<section id="events">
  <div class="container-lp">
    <div class="text-center mb-5">
      <div class="section-tag">Events & Celebrations</div>
      <h2 class="section-title">We Make Every Occasion Unforgettable</h2>
      <p class="section-sub">From intimate gatherings to grand celebrations â€” Balai-Reserve has the perfect venue, package, and team to bring your vision to life.</p>
    </div>

    <%# Event types pills %>
    <div class="event-type-strip justify-content-center mb-5">
      <% for (const [icon, label] of [
        ['fas fa-ring',          'Weddings'],
        ['fas fa-birthday-cake', 'Birthdays'],
        ['fas fa-crown',         'Debut (18th)'],
        ['fas fa-briefcase',     'Corporate Events'],
        ['fas fa-users',         'Meetings'],
        ['fas fa-glass-cheers',  'Parties'],
        ['fas fa-home',          'Family Gatherings'],
        ['fas fa-star',          'Custom Events']
      ]) { %>
      <div class="event-type-pill">
        <i class="<%= icon %>"></i><%= label %>
      </div>
      <% } %>
    </div>

    <%# Event Packages %>
    <div class="row g-3">
      <% for (const p of eventPackages) { %>
      <%
        const pkgColors = {
          wedding:          ['#7c3aed','#ede9fe'],
          birthday:         ['#d97706','#fef3c7'],
          debut:            ['#db2777','#fce7f3'],
          corporate:        ['#1d4ed8','#dbeafe'],
          meeting:          ['#059669','#d1fae5'],
          party:            ['#ea580c','#fee2e2'],
          family_gathering: ['#0891b2','#cffafe'],
          other:            ['#374151','#f3f4f6'],
        };
        const type = (p.event_type || 'other').toLowerCase();
        const [iconColor, bgColor] = pkgColors[type] || pkgColors.other;
        let inclusions = [];
        try { inclusions = JSON.parse(p.inclusions || '[]'); } catch {}
      %>
      <div class="col-12 col-md-6 col-lg-4">
        <div class="event-card">
          <div class="event-icon" style="background:<%= bgColor %>;color:<%= iconColor %>;">
            <% if (type==='wedding') { %><i class="fas fa-ring"></i>
            <% } else if (type==='birthday') { %><i class="fas fa-birthday-cake"></i>
            <% } else if (type==='debut') { %><i class="fas fa-crown"></i>
            <% } else if (type==='corporate') { %><i class="fas fa-briefcase"></i>
            <% } else if (type==='meeting') { %><i class="fas fa-chalkboard-teacher"></i>
            <% } else { %><i class="fas fa-star"></i><% } %>
          </div>
          <div class="event-type" style="color:<%= iconColor %>;"><%= p.event_type ? p.event_type.replace(/_/g,' ').replace(/\b\w/g,l=>l.toUpperCase()) : 'Event' %></div>
          <div class="event-name"><%= p.name %></div>
          <% if (p.description) { %>
          <div class="event-desc"><%= p.description.slice(0,120) %><%= p.description.length>120?'â€¦':'' %></div>
          <% } %>
          <% if (p.capacity) { %>
          <div style="font-size:.78rem;color:var(--text-muted);margin-bottom:.75rem;"><i class="fas fa-users me-1"></i>Up to <%= p.capacity %> guests</div>
          <% } %>
          <% if (inclusions.length > 0) { %>
          <ul class="event-incl">
            <% for (const inc of inclusions.slice(0,5)) { %>
            <li><%= inc %></li>
            <% } %>
            <% if (inclusions.length > 5) { %>
            <li style="color:var(--text-muted);font-style:italic;">+<%= inclusions.length-5 %> more inclusions</li>
            <% } %>
          </ul>
          <% } %>
          <div class="event-price-row">
            <div>
              <div class="event-price"><%= formatPeso(p.price) %></div>
              <div style="font-size:.7rem;color:var(--text-muted);">50% DP: <%= formatPeso(Math.ceil(p.price*0.5)) %></div>
            </div>
            <a href="/portal/book?type=event&package_id=<%= p.id %>" class="btn-brand" style="padding:.45rem 1.1rem;font-size:.82rem;border-radius:6px;">Book Package</a>
          </div>
        </div>
      </div>
      <% } %>
    </div>

    <div class="text-center mt-4">
      <p style="color:var(--text-muted);font-size:.9rem;">Need a custom event package? We'll work with you to create the perfect celebration.</p>
      <a href="/portal/inquire" class="btn-brand"><i class="fas fa-envelope me-2"></i>Inquire About Custom Events</a>
    </div>
  </div>
</section>

<%# â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• %>
<%# â”€â”€ AMENITIES / FACILITIES â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ %>
<%# â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• %>
<section id="amenities" class="bg-off">
  <div class="container-lp">
    <div class="text-center mb-5">
      <div class="section-tag">Facilities & Amenities</div>
      <h2 class="section-title">Everything You Need for a Perfect Stay</h2>
      <p class="section-sub">Balai-Reserve is equipped with all the facilities to make your stay comfortable, memorable, and hassle-free.</p>
    </div>

    <div class="facility-grid">
      <% for (const [icon, name, desc] of [
        ['fas fa-wifi',              'Free WiFi',          'High-speed internet throughout the property'],
        ['fas fa-snowflake',         'Air Conditioning',   'Climate-controlled rooms and function halls'],
        ['fas fa-swimming-pool',     'Swimming Pool',      'Refreshing pool for guests and events'],
        ['fas fa-parking',           'Free Parking',       'Spacious, secure parking area on-site'],
        ['fas fa-utensils',          'Dining',             'In-house catering and on-site restaurant'],
        ['fas fa-video',             'Projector & AV',     'Full AV equipment for events and meetings'],
        ['fas fa-microphone',        'Sound System',       'Professional PA system for all events'],
        ['fas fa-spa',               'Garden & Grounds',   'Beautifully maintained garden areas'],
        ['fas fa-concierge-bell',    '24/7 Front Desk',    'Our team is always here to assist you'],
        ['fas fa-broom',             'Housekeeping',       'Daily room cleaning and turndown service'],
        ['fas fa-qrcode',            'QR Check-in',        'Fast, contactless check-in on arrival'],
        ['fas fa-shield-alt',        'Security',           'On-site security and CCTV monitoring'],
      ]) { %>
      <div class="facility-card">
        <div class="facility-icon"><i class="<%= icon %>"></i></div>
        <div class="facility-name"><%= name %></div>
        <div class="facility-desc"><%= desc %></div>
      </div>
      <% } %>
    </div>
  </div>
</section>

<%# â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• %>
<%# â”€â”€ HOW TO BOOK â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ %>
<%# â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• %>
<section id="how-to-book">
  <div class="container-lp">
    <div class="text-center mb-5">
      <div class="section-tag">Booking Process</div>
      <h2 class="section-title">Book Your Stay in 4 Easy Steps</h2>
      <p class="section-sub">Our online booking system makes reserving a room, venue, or event package quick and hassle-free.</p>
    </div>

    <div class="row g-4">
      <% for (const [num, icon, title, desc, color] of [
        ['1', 'fas fa-search',        'Browse',          'Explore our rooms, venues, and cottages with photos, prices, and availability in real time.', '#4f46e5'],
        ['2', 'fas fa-calendar-plus', 'Select & Book',   'Choose your preferred dates, select a room or package, fill in your details, and submit.', '#10b981'],
        ['3', 'fas fa-money-bill-wave','Pay Downpayment', 'Send 50% downpayment via GCash, bank transfer, Maya, or cash at our front desk.', '#d97706'],
        ['4', 'fas fa-qrcode',        'Arrive & Enjoy',  'Receive your QR code by email. Scan it at check-in for fast, contactless entry.', '#ef4444'],
      ]) { %>
      <div class="col-6 col-md-3">
        <div class="step-card">
          <div class="step-number" style="background:<%= color %>;box-shadow:0 4px 16px <%= color %>44;"><%= num %></div>
          <div class="step-icon"><i class="<%= icon %>" style="color:<%= color %>;"></i></div>
          <div class="step-title"><%= title %></div>
          <div class="step-desc"><%= desc %></div>
        </div>
      </div>
      <% } %>
    </div>

    <%# Payment methods accepted %>
    <div class="payment-methods-box mt-5">
      <div class="text-center mb-3">
        <strong style="font-size:.85rem;color:var(--text);">Accepted Payment Methods</strong>
      </div>
      <div class="d-flex flex-wrap justify-content-center gap-3">
        <% for (const [icon, label, color] of [
          ['fas fa-mobile-alt', 'GCash',         '#007945'],
          ['fas fa-university', 'BDO / BPI',     '#1d4ed8'],
          ['fas fa-wallet',     'Maya',          '#7c3aed'],
          ['fas fa-money-bills','Cash (Front Desk)','#d97706'],
        ]) { %>
        <div class="d-flex align-items-center gap-2 px-3 py-2 bg-white rounded-3 border" style="font-size:.85rem;font-weight:600;">
          <i class="<%= icon %>" style="color:<%= color %>;"></i><%= label %>
        </div>
        <% } %>
      </div>
      <p class="text-center mb-0 mt-2" style="font-size:.78rem;color:var(--text-muted);">
        50% downpayment required to confirm. Balance payable before or upon check-in.
        <a href="/portal/inquire" style="color:var(--neon-cyan);">Questions? Contact us.</a>
      </p>
    </div>

    <div class="text-center mt-4">
      <a href="/auth/login" class="btn-brand me-2"><i class="fas fa-sign-in-alt me-2"></i>Sign In to Book</a>
      <a href="/portal" class="btn-gold"><i class="fas fa-compass me-2"></i>Browse Without Account</a>
    </div>
  </div>
</section>

<%# â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• %>
<%# â”€â”€ TESTIMONIALS â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ %>
<%# â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• %>
<% if (reviews && reviews.length > 0) { %>
<section class="bg-off" id="reviews">
  <div class="container-lp">
    <div class="text-center mb-5">
      <div class="section-tag">Guest Reviews</div>
      <h2 class="section-title">What Our Guests Say</h2>
      <p class="section-sub">Real reviews from guests who have experienced Balai-Reserve.</p>
    </div>
    <div class="row g-3">
      <% for (const r of reviews) { %>
      <div class="col-12 col-md-4">
        <div class="testimonial-card">
          <div class="testimonial-stars">
            <% for (let s=1;s<=5;s++) { %><i class="fas fa-star<%= s<=r.rating?'':'-o' %>"></i><% } %>
          </div>
          <div class="testimonial-text">"<%= r.comments ? r.comments.slice(0,180) + (r.comments.length>180?'â€¦':'') : '' %>"</div>
          <div class="testimonial-author"><%= r.customer_name %></div>
          <div class="testimonial-date"><%= formatDate(r.created_at) %></div>
        </div>
      </div>
      <% } %>
    </div>
  </div>
</section>
<% } %>

<%# â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• %>
<%# â”€â”€ CTA + CONTACT SECTION â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ %>
<%# â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• %>
<section class="cta-section" id="contact">
  <div class="container-lp" style="position:relative;z-index:2;">
    <div class="row align-items-center g-5">
      <div class="col-lg-6 text-center text-lg-start">
        <div class="section-tag">Get In Touch</div>
        <h2 class="cta-title">Ready to Create Lasting Memories?</h2>
        <p class="cta-sub mx-0">Book your stay today or contact us for custom event inquiries. Our team is ready to make your experience exceptional.</p>
        <div class="d-flex flex-wrap gap-3 justify-content-center justify-content-lg-start">
          <a href="/portal/book"   class="btn-gold"><i class="fas fa-calendar-plus me-2"></i>Book Now</a>
          <a href="/portal/inquire" class="btn-outline-white"><i class="fas fa-envelope me-2"></i>Send Inquiry</a>
        </div>
      </div>

      <div class="col-lg-6">
        <div class="contact-glass-card">
          <h5 style="color:#fff;font-weight:700;margin-bottom:1.5rem;"><i class="fas fa-address-card me-2" style="color:var(--gold);"></i>Find & Contact Us</h5>
          <div class="contact-item">
            <div class="contact-icon"><i class="fas fa-map-marker-alt"></i></div>
            <div>
              <div class="contact-label">Address</div>
              <div class="contact-value"><%= site.resort_address || 'Miciano Road, Quezon City, Philippines' %></div>
            </div>
          </div>
          <div class="contact-item">
            <div class="contact-icon"><i class="fas fa-phone-alt"></i></div>
            <div>
              <div class="contact-label">Phone</div>
              <div class="contact-value"><%= site.resort_phone || '(02) 8123-4567' %></div>
            </div>
          </div>
          <div class="contact-item">
            <div class="contact-icon"><i class="fas fa-envelope"></i></div>
            <div>
              <div class="contact-label">Email</div>
              <div class="contact-value"><%= site.resort_email || 'info@balai-reserve.com' %></div>
            </div>
          </div>
          <div class="contact-item">
            <div class="contact-icon"><i class="fas fa-clock"></i></div>
            <div>
              <div class="contact-label">Check-in / Check-out</div>
              <div class="contact-value">Check-in: <%= site.check_in_time || '2:00 PM' %> &nbsp;&middot;&nbsp; Check-out: <%= site.check_out_time || '12:00 PM' %></div>
            </div>
          </div>
          <div class="contact-item mb-0">
            <div class="contact-icon"><i class="fab fa-facebook"></i></div>
            <div>
              <div class="contact-label">Facebook Page</div>
              <div class="contact-value">
                <a href="https://www.facebook.com/BalaiMiciano" target="_blank" rel="noopener noreferrer"
                  style="color:rgba(255,255,255,.9);text-decoration:underline;">
                  facebook.com/BalaiMiciano
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<%# â”€â”€ FOOTER â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ %>
<footer class="landing-footer">
  <div class="container-lp">
    <div class="row g-4 mb-4">
      <div class="col-12 col-md-4">
        <div class="d-flex align-items-center gap-2 mb-2">
          <div style="width:34px;height:34px;background:linear-gradient(135deg,#ffd166,#e6a800);border-radius:8px;display:flex;align-items:center;justify-content:center;color:#0a0a0a;font-size:.9rem;box-shadow:0 0 10px rgba(255,209,102,.35);"><i class="fas fa-home"></i></div>
          <div class="footer-brand-name">Balai-Reserve</div>
        </div>
        <div class="footer-brand-sub mb-3">Your Home Away From Home</div>
        <p style="font-size:.8rem;line-height:1.7;margin-bottom:1rem;">
          A premier resort and event venue in Brgy. San Antonio, Gloria, Oriental Mindoro — offering rooms, venues, cottages, and full event management services.
        </p>
        <div class="footer-social d-flex gap-2">
          <a href="https://www.facebook.com/BalaiMiciano" target="_blank" rel="noopener noreferrer" title="Facebook"><i class="fab fa-facebook-f"></i></a>
          <a href="mailto:<%= site.resort_email || 'info@balai-reserve.com' %>" title="Email"><i class="fas fa-envelope"></i></a>
          <a href="tel:<%= site.resort_phone || '' %>" title="Phone"><i class="fas fa-phone-alt"></i></a>
        </div>
      </div>

      <div class="col-6 col-md-2">
        <div style="font-size:.82rem;font-weight:700;color:rgba(255,255,255,.7);margin-bottom:.875rem;text-transform:uppercase;letter-spacing:.07em;">Browse</div>
        <div class="d-flex flex-column gap-2" style="font-size:.83rem;">
          <a href="/portal/rooms"    class="footer-link">Rooms</a>
          <a href="/portal/venues"   class="footer-link">Venues</a>
          <a href="/portal/cottages" class="footer-link">Cottages</a>
          <a href="/portal/venues"   class="footer-link">Event Packages</a>
        </div>
      </div>

      <div class="col-6 col-md-2">
        <div style="font-size:.82rem;font-weight:700;color:rgba(255,255,255,.7);margin-bottom:.875rem;text-transform:uppercase;letter-spacing:.07em;">Quick Links</div>
        <div class="d-flex flex-column gap-2" style="font-size:.83rem;">
          <a href="/#about"        class="footer-link">About Us</a>
          <a href="/#amenities"    class="footer-link">Amenities</a>
          <a href="/#how-to-book"  class="footer-link">How to Book</a>
          <a href="/portal/inquire" class="footer-link">Contact Us</a>
          <a href="/auth/login"    class="footer-link">Staff Login</a>
        </div>
      </div>

      <div class="col-12 col-md-4">
        <div style="font-size:.82rem;font-weight:700;color:rgba(255,255,255,.7);margin-bottom:.875rem;text-transform:uppercase;letter-spacing:.07em;">Contact</div>
        <div style="font-size:.83rem;" class="d-flex flex-column gap-2">
          <div><i class="fas fa-map-marker-alt me-2 text-gold"></i><%= site.resort_address || 'Brgy. San Antonio, Gloria, Oriental Mindoro' %></div>
          <div><i class="fas fa-phone-alt me-2 text-gold"></i><%= site.resort_phone || '(02) 8123-4567' %></div>
          <div><i class="fas fa-envelope me-2 text-gold"></i><%= site.resort_email || 'info@balai-reserve.com' %></div>
          <div><i class="fas fa-clock me-2 text-gold"></i>Check-in: <%= site.check_in_time || '2:00 PM' %> &middot; Out: <%= site.check_out_time || '12:00 PM' %></div>
        </div>
      </div>
    </div>

    <hr class="footer-divider" />
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2" style="font-size:.78rem;">
      <div>&copy; <%= new Date().getFullYear() %> Balai-Reserve. All rights reserved.</div>
      <div class="d-flex gap-3">
        <a href="/portal/inquire" class="footer-link">Privacy Policy</a>
        <a href="/portal/inquire" class="footer-link">Terms of Use</a>
        <a href="https://www.facebook.com/BalaiMiciano" target="_blank" class="footer-link">Facebook</a>
      </div>
    </div>
  </div>
</footer>

