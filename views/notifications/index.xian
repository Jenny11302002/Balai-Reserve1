<% layout('layouts/main') %>
<div class="page-header">
  <div><h3 class="mb-1">Notifications</h3><p class="text-muted mb-0">All system notifications</p></div>
  <div class="page-header-actions">
    <form action="/notifications/clear" method="POST"><button type="submit" class="btn btn-sm btn-outline-secondary">Clear Read</button></form>
  </div>
</div>
<div class="card">
  <div class="card-body p-0">
    <% if (!notifications || notifications.length === 0) { %>
    <div class="empty-state py-5"><i class="fas fa-bell-slash fa-2x text-muted"></i><p class="mt-2 text-muted">No notifications.</p></div>
    <% } else { %>
    <div class="notif-full-list">
      <% for (const n of notifications) { %>
      <div class="notif-full-item <%= n.is_read ? 'read' : 'unread' %>">
        <div class="notif-full-icon notif-<%= n.type %>">
          <% if (n.type === 'reservation') { %><i class="fas fa-calendar-check"></i>
          <% } else if (n.type === 'payment') { %><i class="fas fa-money-bill-wave"></i>
          <% } else if (n.type === 'inventory') { %><i class="fas fa-exclamation-triangle"></i>
          <% } else if (n.type === 'inquiry') { %><i class="fas fa-question-circle"></i>
          <% } else { %><i class="fas fa-bell"></i><% } %>
        </div>
        <div class="notif-full-text">
          <div class="notif-full-title"><%= n.title %></div>
          <div class="notif-full-msg"><%= n.message %></div>
          <div class="notif-full-meta text-muted small"><%= formatDateTime(n.created_at) %></div>
        </div>
        <div class="notif-full-actions">
          <% if (!n.is_read) { %><span class="unread-dot"></span><% } %>
          <% if (n.link) { %><a href="<%= n.link %>" class="btn btn-xs btn-outline-primary">View</a><% } %>
        </div>
      </div>
      <% } %>
    </div>
    <% } %>
  </div>
  <div class="card-footer"><%include('partials/pagination')%></div>
</div>
