<nav class="sidebar" id="sidebar">

  <!-- Brand -->
  <div class="sidebar-brand">
    <div class="brand-icon-sm"><i class="fas fa-home"></i></div>
    <span class="brand-text">Balai-Reserve</span>
    <button class="sidebar-close d-lg-none" id="sidebarClose" aria-label="Close sidebar">
      <i class="fas fa-times"></i>
    </button>
  </div>

  <!-- User Info -->
  <% if (currentUser) { %>
  <a href="/profile" class="sidebar-user text-decoration-none" style="display:flex;">
    <div class="user-avatar">
      <% if (currentUser.avatar) { %>
        <img src="<%= currentUser.avatar %>" alt="Avatar" />
      <% } else { %>
        <span><%= currentUser.firstName.charAt(0) %><%= currentUser.lastName.charAt(0) %></span>
      <% } %>
    </div>
    <div class="user-info">
      <div class="user-name"><%= currentUser.firstName %> <%= currentUser.lastName %></div>
      <div class="user-role"><%= currentUser.roleLabel %></div>
    </div>
  </a>
  <% } %>

  <ul class="sidebar-nav">

    <!-- ── Dashboard ──────────────────────────────────── -->
    <li class="nav-item">
      <a href="/dashboard" class="nav-link <%= activeNav(currentPath, '/dashboard') %>">
        <i class="fas fa-tachometer-alt nav-icon"></i><span>Dashboard</span>
      </a>
    </li>

    <!-- ── BOOKINGS section ───────────────────────────── -->
    <% if (currentUser && (currentUser.role === 'admin' || currentUser.role === 'staff')) { %>
    <li class="nav-section-label">Bookings</li>

    <li class="nav-item">
      <a href="/reservations" class="nav-link <%= activeNav(currentPath, '/reservations') %>">
        <i class="fas fa-calendar-check nav-icon"></i><span>Reservations</span>
        <% if (pendingReservationsCount > 0) { %>
          <span class="nav-badge" title="<%= pendingReservationsCount %> reservation(s) need attention (pending review or awaiting payment)"><%= pendingReservationsCount %></span>
        <% } %>
      </a>
    </li>

    <li class="nav-item">
      <a href="/reservations/view/calendar" class="nav-link <%= activeNav(currentPath, '/reservations/view/calendar') %>">
        <i class="fas fa-calendar-alt nav-icon"></i><span>Booking Calendar</span>
      </a>
    </li>

    <li class="nav-item">
      <a href="/guests" class="nav-link <%= activeNav(currentPath, '/guests') %>">
        <i class="fas fa-users nav-icon"></i><span>Guests</span>
      </a>
    </li>

    <li class="nav-item">
      <a href="/payments" class="nav-link <%= activeNav(currentPath, '/payments') %>">
        <i class="fas fa-money-bill-wave nav-icon"></i><span>Payments</span>
      </a>
    </li>

    <li class="nav-item">
      <a href="/payments/refunds/requests" class="nav-link <%= activeNav(currentPath, '/payments/refunds/requests') %>">
        <i class="fas fa-hand-holding-usd nav-icon"></i><span>Refund Requests</span>
      </a>
    </li>

    <li class="nav-item">
      <a href="/inquiries" class="nav-link <%= activeNav(currentPath, '/inquiries') %>">
        <i class="fas fa-question-circle nav-icon"></i><span>Inquiries</span>
        <% if (pendingInquiriesCount > 0) { %>
          <span class="nav-badge"><%= pendingInquiriesCount %></span>
        <% } %>
      </a>
    </li>
    <% } %>

    <!-- ── ACCOMMODATIONS section ─────────────────────── -->
    <% if (currentUser && (currentUser.role === 'admin' || currentUser.role === 'staff')) { %>
    <li class="nav-section-label">Accommodations</li>

    <li class="nav-item">
      <a href="/rooms" class="nav-link <%= activeNav(currentPath, '/rooms') %>">
        <i class="fas fa-door-open nav-icon"></i><span>Rooms</span>
      </a>
    </li>

    <li class="nav-item">
      <a href="/venues" class="nav-link <%= activeNav(currentPath, '/venues') %>">
        <i class="fas fa-map-marker-alt nav-icon"></i><span>Venues</span>
      </a>
    </li>

    <li class="nav-item">
      <a href="/cottages" class="nav-link <%= activeNav(currentPath, '/cottages') %>">
        <i class="fas fa-home nav-icon"></i><span>Cottages</span>
      </a>
    </li>
    <% } %>

    <!-- ── EVENTS section ─────────────────────────────── -->
    <% if (currentUser && (currentUser.role === 'admin' || currentUser.role === 'staff')) { %>
    <li class="nav-section-label">Events</li>

    <li class="nav-item">
      <a href="/events" class="nav-link <%= activeNav(currentPath, '/events') %>">
        <i class="fas fa-star nav-icon"></i><span>Events</span>
      </a>
    </li>
    <% } %>

    <!-- ── INVENTORY section ──────────────────────────── -->
    <% if (currentUser && (currentUser.role === 'admin' || currentUser.role === 'staff')) { %>
    <li class="nav-section-label">Inventory</li>

    <li class="nav-item">
      <a href="/inventory" class="nav-link <%= activeNav(currentPath, '/inventory') %>">
        <i class="fas fa-boxes nav-icon"></i><span>Inventory</span>
      </a>
    </li>
    <% } %>

    <!-- ── CRM section ────────────────────────────────── -->
    <% if (currentUser && (currentUser.role === 'admin' || currentUser.role === 'staff')) { %>
    <li class="nav-section-label">CRM</li>

    <li class="nav-item">
      <a href="/crm" class="nav-link <%= activeNav(currentPath, '/crm') %>">
        <i class="fas fa-user-tie nav-icon"></i><span>Customers</span>
      </a>
    </li>

    <li class="nav-item">
      <a href="/crm/calls" class="nav-link <%= activeNav(currentPath, '/crm/calls') %>">
        <i class="fas fa-phone nav-icon"></i><span>Sales Calls</span>
      </a>
    </li>

    <li class="nav-item">
      <a href="/crm/tickets" class="nav-link <%= activeNav(currentPath, '/crm/tickets') %>">
        <i class="fas fa-ticket-alt nav-icon"></i><span>Support Tickets</span>
      </a>
    </li>

    <li class="nav-item">
      <a href="/feedback" class="nav-link <%= activeNav(currentPath, '/feedback') %>">
        <i class="fas fa-star-half-alt nav-icon"></i><span>Feedback</span>
      </a>
    </li>
    <% } %>

    <!-- ── MANAGEMENT section (admin only) ───────────── -->
    <% if (currentUser && currentUser.role === 'admin') { %>
    <li class="nav-section-label">Management</li>

    <li class="nav-item">
      <a href="/reports" class="nav-link <%= activeNav(currentPath, '/reports') %>">
        <i class="fas fa-file-alt nav-icon"></i><span>Reports</span>
      </a>
    </li>

    <li class="nav-item">
      <a href="/analytics" class="nav-link <%= activeNav(currentPath, '/analytics') %>">
        <i class="fas fa-chart-line nav-icon"></i><span>Analytics & AI</span>
      </a>
    </li>

    <li class="nav-item">
      <a href="/users" class="nav-link <%= activeNav(currentPath, '/users') %>">
        <i class="fas fa-users-cog nav-icon"></i><span>User Management</span>
      </a>
    </li>

    <li class="nav-item">
      <a href="/settings" class="nav-link <%= activeNav(currentPath, '/settings') %>">
        <i class="fas fa-cog nav-icon"></i><span>Settings</span>
      </a>
    </li>
    <% } %>

  </ul>

  <!-- Sidebar Footer: Profile + Logout -->
  <div class="sidebar-footer">
    <a href="/profile" class="nav-link <%= activeNav(currentPath, '/profile') %>" style="opacity:.85;">
      <i class="fas fa-user-circle nav-icon"></i><span>My Profile</span>
    </a>
    <a href="/auth/logout" class="nav-link logout-link">
      <i class="fas fa-sign-out-alt nav-icon"></i><span>Logout</span>
    </a>
  </div>

</nav>

<!-- Sidebar Overlay (mobile tap-outside to close) -->
<div class="sidebar-overlay" id="sidebarOverlay"></div>
