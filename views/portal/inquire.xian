<% layout('layouts/portal') %>
<div class="container-lg px-4 py-5">
  <div class="row justify-content-center">
    <div class="col-lg-7">
      <div class="bg-white rounded-3 border shadow-sm p-4">
        <h4 class="fw-bold mb-1"><i class="fas fa-envelope me-2 text-primary"></i>Contact Us</h4>
        <p class="text-muted small mb-4">Have a question or need help? Send us a message and we'll get back to you.</p>

        <% if (errors && errors.length > 0) { %>
        <div class="alert alert-danger"><% for(const e of errors){%><div><%= e.msg %></div><%}%></div>
        <% } %>

        <form action="/portal/inquire" method="POST">
          <div class="row g-3">
            <div class="col-md-6"><label class="form-label required">Your Name</label><input type="text" name="name" class="form-control" value="<%= old.name || (currentUser ? currentUser.firstName + ' ' + currentUser.lastName : '') %>" required /></div>
            <div class="col-md-6"><label class="form-label">Email</label><input type="email" name="email" class="form-control" value="<%= old.email || (currentUser ? currentUser.email : '') %>" /></div>
            <div class="col-md-6"><label class="form-label">Phone</label><input type="text" name="phone" class="form-control" value="<%= old.phone || '' %>" placeholder="09XX-XXX-XXXX" /></div>
            <div class="col-md-6"><label class="form-label">Category</label>
              <select name="category" class="form-select">
                <% for (const [v,l] of [['general','General Inquiry'],['room','Room & Accommodation'],['venue','Venue & Events'],['pricing','Pricing & Packages'],['complaint','Complaint'],['other','Other']]) { %>
                <option value="<%= v %>" <%= (old.category||'general')===v?'selected':'' %>><%= l %></option>
                <% } %>
              </select>
            </div>
            <div class="col-12"><label class="form-label required">Subject</label><input type="text" name="subject" class="form-control" value="<%= old.subject||'' %>" required /></div>
            <div class="col-12"><label class="form-label required">Message</label><textarea name="message" class="form-control" rows="5" required><%= old.message||'' %></textarea></div>
          </div>
          <div class="d-flex gap-3 mt-4">
            <button type="submit" class="btn btn-primary px-4"><i class="fas fa-paper-plane me-2"></i>Send Inquiry</button>
            <a href="/portal" class="btn btn-outline-secondary">Back</a>
          </div>
        </form>
      </div>

      <div class="bg-white rounded-3 border p-4 mt-3">
        <h6 class="fw-bold mb-3">Or chat with our assistant</h6>
        <p class="text-muted small mb-2">Get instant answers about room availability, pricing, and packages using our chatbot — look for the chat icon at the bottom right.</p>
      </div>
    </div>
  </div>
</div>
