<% layout('layouts/main') %>

<div class="print-header d-none">
  <div class="print-resort-name"><%= resort.name %></div>
  <div class="print-resort-addr"><%= resort.address %><% if (resort.phone) { %> &bull; Tel: <%= resort.phone %><% } %><% if (resort.email) { %> &bull; <%= resort.email %><% } %></div>
  <div class="print-report-title">Event Report &mdash; <%= filters.from %> to <%= filters.to %></div>
</div>

<div class="page-header no-print">
  <div><nav aria-label="breadcrumb"><ol class="breadcrumb mb-1"><li class="breadcrumb-item"><a href="/reports">Reports</a></li><li class="breadcrumb-item active">Event Report</li></ol></nav><h3 class="mb-0">Event Report</h3></div>
  <div class="page-header-actions d-flex gap-2">
    <div class="btn-group btn-group-sm">
      <a href="/reports/export/events?format=xlsx&from=<%= filters.from %>&to=<%= filters.to %>" class="btn btn-outline-success"><i class="fas fa-file-excel me-1"></i>Excel</a>
      <a href="/reports/export/events?format=docx&from=<%= filters.from %>&to=<%= filters.to %>" class="btn btn-outline-primary"><i class="fas fa-file-word me-1"></i>Word</a>
      <a href="/reports/export/events?format=csv&from=<%= filters.from %>&to=<%= filters.to %>" class="btn btn-outline-secondary"><i class="fas fa-file-csv me-1"></i>CSV</a>
    </div>
    <button type="button" class="btn btn-sm btn-dark" onclick="window.print()"><i class="fas fa-print me-1"></i>Print</button>
  </div>
</div>
<div class="card mb-3"><div class="card-body py-2">
  <form method="GET" action="/reports/events" class="row g-2 align-items-end">
    <div class="col-6 col-md-3"><input type="date" name="from" value="<%= filters.from %>" class="form-control form-control-sm" /></div>
    <div class="col-6 col-md-3"><input type="date" name="to" value="<%= filters.to %>" class="form-control form-control-sm" /></div>
    <div class="col-6 col-md-3"><button type="submit" class="btn btn-sm btn-primary w-100">Generate</button></div>
  </form>
</div></div>
<div class="row g-3 mb-3">
  <div class="col-md-4"><div class="stat-card stat-warning"><div class="stat-icon"><i class="fas fa-star"></i></div><div class="stat-body"><div class="stat-value"><%= events.length %></div><div class="stat-label">Total Events</div></div></div></div>
  <div class="col-md-4"><div class="stat-card stat-info"><div class="stat-icon"><i class="fas fa-users"></i></div><div class="stat-body"><div class="stat-value"><%= totalAttendees.toLocaleString() %></div><div class="stat-label">Total Attendees</div></div></div></div>
  <div class="col-md-4"><div class="stat-card stat-success"><div class="stat-icon"><i class="fas fa-coins"></i></div><div class="stat-body"><div class="stat-value"><%= formatPeso(totalRevenue) %></div><div class="stat-label">Total Revenue</div></div></div></div>
</div>
<div class="card"><div class="card-body p-0">
  <table class="table table-hover mb-0">
    <thead><tr><th>Event Name</th><th>Customer</th><th>Type</th><th>Date</th><th>Venue</th><th>Attendees</th><th>Cost</th><th>Status</th></tr></thead>
    <tbody>
      <% if (!events || events.length === 0) { %><tr><td colspan="8" class="text-center py-4 text-muted">No events in this period.</td></tr>
      <% } else { %>
        <% for (const e of events) { %>
        <tr><td><a href="/events/<%= e.id %>"><%= e.event_name %></a></td><td><%= e.customer_name %></td><td><span class="badge bg-light text-dark small"><%= e.event_type %></span></td><td class="small text-nowrap"><%= formatDate(e.event_date) %></td><td class="small"><%= e.venue_name || '—' %></td><td class="text-center"><%= e.num_attendees %></td><td><%= formatPeso(e.total_cost) %></td><td><%- statusBadge(e.status) %></td></tr>
        <% } %>
      <% } %>
    </tbody>
  </table>
</div></div>

<div class="print-footer d-none">Generated by <%= resort.name %> Booking System</div>

<style>
@media print {
  .sidebar, .app-navbar, .navbar, .app-footer, .no-print, #toastContainer, .breadcrumb { display: none !important; }
  .main-wrapper, .page-content, .content-wrapper { margin: 0 !important; padding: 0 !important; width: 100% !important; }
  body { background: #fff !important; }
  .print-header { display: block !important; text-align: center; border-bottom: 2px solid #15803d; padding-bottom: 8px; margin-bottom: 16px; }
  .print-resort-name { font-size: 20px; font-weight: 700; color: #15803d; }
  .print-resort-addr { font-size: 11px; color: #555; }
  .print-report-title { font-size: 14px; font-weight: 700; margin-top: 6px; }
  .print-footer { display: block !important; text-align: center; font-size: 10px; color: #777; border-top: 1px solid #cbd5e1; padding-top: 6px; margin-top: 18px; }
  .card { border: none !important; box-shadow: none !important; }
  .stat-card { border: 1px solid #e5e7eb !important; }
  table { font-size: 11px; }
  thead { display: table-header-group; }
  tr { page-break-inside: avoid; }
  @page { margin: 14mm; }
}
</style>
