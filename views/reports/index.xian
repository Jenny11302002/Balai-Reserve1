<% layout('layouts/main') %>
<div class="page-header"><div><h3 class="mb-1">Reports</h3><p class="text-muted mb-0">Generate and export business reports</p></div></div>
<div class="row g-3">
  <div class="col-md-4">
    <div class="card report-card h-100"><div class="card-body text-center p-4">
      <div class="report-icon bg-success-soft"><i class="fas fa-coins"></i></div>
      <h5 class="mt-3">Sales Report</h5>
      <p class="text-muted small">View daily, weekly, monthly, and yearly sales data with revenue breakdowns.</p>
      <a href="/reports/sales" class="btn btn-success w-100"><i class="fas fa-chart-bar me-1"></i>View Sales Report</a>
    </div></div>
  </div>
  <div class="col-md-4">
    <div class="card report-card h-100"><div class="card-body text-center p-4">
      <div class="report-icon bg-primary-soft"><i class="fas fa-calendar-check"></i></div>
      <h5 class="mt-3">Reservation Report</h5>
      <p class="text-muted small">Track all reservations by status, type, date range with summary statistics.</p>
      <a href="/reports/reservations" class="btn btn-primary w-100"><i class="fas fa-chart-bar me-1"></i>View Reservation Report</a>
    </div></div>
  </div>
  <div class="col-md-4">
    <div class="card report-card h-100"><div class="card-body text-center p-4">
      <div class="report-icon bg-warning-soft"><i class="fas fa-star"></i></div>
      <h5 class="mt-3">Event Report</h5>
      <p class="text-muted small">Analyze event bookings, types, revenue, attendee counts, and upcoming events.</p>
      <a href="/reports/events" class="btn btn-warning w-100"><i class="fas fa-chart-bar me-1"></i>View Event Report</a>
    </div></div>
  </div>
</div>
<div class="card mt-4">
  <div class="card-header"><h6 class="card-title mb-0"><i class="fas fa-download me-2"></i>Quick Export</h6></div>
  <div class="card-body">
    <p class="text-muted small mb-3">Choose a date range and export in Excel, Word, or CSV. Exports include the resort name and address in the header/footer.</p>
    <div class="row g-4">
      <div class="col-md-4">
        <div class="mb-2 fw-medium small">Sales Export</div>
        <div class="d-flex gap-2 mb-2">
          <input type="date" id="salesFrom" class="form-control form-control-sm" />
          <input type="date" id="salesTo" class="form-control form-control-sm" />
        </div>
        <div class="btn-group btn-group-sm w-100">
          <button class="btn btn-outline-success" onclick="exportReport('sales','salesFrom','salesTo','xlsx')"><i class="fas fa-file-excel me-1"></i>Excel</button>
          <button class="btn btn-outline-primary" onclick="exportReport('sales','salesFrom','salesTo','docx')"><i class="fas fa-file-word me-1"></i>Word</button>
          <button class="btn btn-outline-secondary" onclick="exportReport('sales','salesFrom','salesTo','csv')"><i class="fas fa-file-csv me-1"></i>CSV</button>
        </div>
      </div>
      <div class="col-md-4">
        <div class="mb-2 fw-medium small">Reservations Export</div>
        <div class="d-flex gap-2 mb-2">
          <input type="date" id="resFrom" class="form-control form-control-sm" />
          <input type="date" id="resTo" class="form-control form-control-sm" />
        </div>
        <div class="btn-group btn-group-sm w-100">
          <button class="btn btn-outline-success" onclick="exportReport('reservations','resFrom','resTo','xlsx')"><i class="fas fa-file-excel me-1"></i>Excel</button>
          <button class="btn btn-outline-primary" onclick="exportReport('reservations','resFrom','resTo','docx')"><i class="fas fa-file-word me-1"></i>Word</button>
          <button class="btn btn-outline-secondary" onclick="exportReport('reservations','resFrom','resTo','csv')"><i class="fas fa-file-csv me-1"></i>CSV</button>
        </div>
      </div>
      <div class="col-md-4">
        <div class="mb-2 fw-medium small">Events Export</div>
        <div class="d-flex gap-2 mb-2">
          <input type="date" id="evtFrom" class="form-control form-control-sm" />
          <input type="date" id="evtTo" class="form-control form-control-sm" />
        </div>
        <div class="btn-group btn-group-sm w-100">
          <button class="btn btn-outline-success" onclick="exportReport('events','evtFrom','evtTo','xlsx')"><i class="fas fa-file-excel me-1"></i>Excel</button>
          <button class="btn btn-outline-primary" onclick="exportReport('events','evtFrom','evtTo','docx')"><i class="fas fa-file-word me-1"></i>Word</button>
          <button class="btn btn-outline-secondary" onclick="exportReport('events','evtFrom','evtTo','csv')"><i class="fas fa-file-csv me-1"></i>CSV</button>
        </div>
      </div>
    </div>
  </div>
</div>
<script>
function exportReport(type, fromId, toId, format) {
  const from = document.getElementById(fromId).value;
  const to   = document.getElementById(toId).value;
  const params = ['format=' + (format || 'csv')];
  if (from) params.push('from=' + from);
  if (to)   params.push('to=' + to);
  window.location.href = '/reports/export/' + type + '?' + params.join('&');
}
</script>
