<% layout('layouts/main') %>

<div class="page-header">
  <div>
    <h3 class="mb-1">Reservations</h3>
    <p class="text-muted mb-0">Manage all bookings and reservations</p>
  </div>
  <div class="page-header-actions">
    <a href="/reservations/view/calendar" class="btn btn-sm btn-outline-primary"><i class="fas fa-calendar me-1"></i>Calendar</a>
    <% if (currentUser && (currentUser.role === 'admin' || currentUser.role === 'staff')) { %>
    <a href="/reservations/new" class="btn btn-sm btn-primary"><i class="fas fa-plus me-1"></i>New Reservation</a>
    <% } %>
  </div>
</div>

<!-- Filters -->
<div class="card mb-3">
  <div class="card-body py-2">
    <form method="GET" action="/reservations" id="reservationsFilterForm" class="row g-2 align-items-end">
      <div class="col-12 col-md-3">
        <input type="text" name="search" value="<%= filters.search %>" class="form-control form-control-sm" placeholder="Booking ref or customer name..." />
      </div>
      <div class="col-6 col-md-2">
        <select name="type" class="form-select form-select-sm">
          <option value="">All Types</option>
          <% for (const t of types) { %><option value="<%= t %>" <%= filters.type === t ? 'selected' : '' %>><%= t %></option><% } %>
        </select>
      </div>
      <div class="col-6 col-md-2">
        <select name="status" class="form-select form-select-sm">
          <option value="">All Statuses</option>
          <% for (const s of statuses) { %><option value="<%= s %>" <%= filters.status === s ? 'selected' : '' %>><%= s.replace(/_/g,' ') %></option><% } %>
        </select>
      </div>
      <div class="col-6 col-md-2">
        <select name="payment" class="form-select form-select-sm">
          <option value="">All Payments</option>
          <% for (const p of payments) { %><option value="<%= p %>" <%= filters.payment === p ? 'selected' : '' %>><%= p.replace(/_/g,' ') %></option><% } %>
        </select>
      </div>
      <div class="col-3 col-md-1">
        <button type="submit" class="btn btn-sm btn-primary w-100"><i class="fas fa-search"></i></button>
      </div>
      <div class="col-3 col-md-1">
        <a href="/reservations" class="btn btn-sm btn-outline-secondary w-100"><i class="fas fa-times"></i></a>
      </div>
      <div class="col-6 col-md-1">
        <a href="/reports/export/reservations" class="btn btn-sm btn-outline-success w-100" title="Export CSV"><i class="fas fa-download"></i></a>
      </div>
    </form>
  </div>
</div>

<!-- Table -->
<div class="card">
  <div class="card-body p-0">
    <div class="table-responsive">
      <table class="table table-hover mb-0">
        <thead>
          <tr>
            <th>Booking Ref</th>
            <th>Customer</th>
            <th class="hide-md">Type</th>
            <th class="hide-md">Date(s)</th>
            <th class="hide-xs">Guests</th>
            <th class="hide-xs">Amount</th>
            <th class="hide-xs">Payment</th>
            <th>Status</th>
            <th>Action</th>
          </tr>
        </thead>
        <tbody>
          <% if (!reservations || reservations.length === 0) { %>
          <tr><td colspan="9" class="text-center py-4 text-muted">No reservations found.</td></tr>
          <% } else { %>
            <% for (const r of reservations) { %>
            <tr>
              <td><a href="/reservations/<%= r.id %>"><code class="small"><%= r.booking_ref %></code></a></td>
              <td>
                <div class="fw-medium"><%= r.customer_name %></div>
                <div class="text-muted small"><%= r.customer_phone || '' %></div>
              </td>
              <td class="hide-md"><span class="badge bg-light text-dark"><%= r.reservation_type %></span></td>
              <td class="small text-nowrap hide-md">
                <% if (r.check_in_date) { %><%= formatDate(r.check_in_date) %><% } %>
                <% if (r.check_out_date) { %> – <%= formatDate(r.check_out_date) %><% } %>
                <% if (r.event_date) { %><%= formatDate(r.event_date) %><% } %>
              </td>
              <td class="text-center hide-xs"><%= r.num_guests %></td>
              <td class="fw-medium hide-xs"><%= formatPeso(r.total_amount) %></td>
              <td class="hide-xs"><%- statusBadge(r.payment_status) %></td>
              <td><%- statusBadge(r.status) %></td>
              <td><a href="/reservations/<%= r.id %>" class="btn btn-xs btn-outline-primary" title="View reservation details">View</a></td>
            </tr>
            <% } %>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
  <div class="card-footer">
    <%include('partials/pagination')%>
  </div>
</div>
