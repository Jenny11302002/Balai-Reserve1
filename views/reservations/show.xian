<% layout('layouts/main') %>

<div class="page-header">
  <div>
    <nav aria-label="breadcrumb"><ol class="breadcrumb mb-1">
      <li class="breadcrumb-item"><a href="/reservations">Reservations</a></li>
      <li class="breadcrumb-item active"><%= reservation.booking_ref %></li>
    </ol></nav>
    <h3 class="mb-0">Reservation <code><%= reservation.booking_ref %></code></h3>
  </div>
  <div class="page-header-actions">
    <%- statusBadge(reservation.status) %>
    <%- statusBadge(reservation.payment_status) %>
  </div>
</div>

<div class="row g-3">

  <%# ── Left column ─────────────────────────────────────────────── %>
  <div class="col-lg-8">

    <%# Reservation Info %>
    <div class="card mb-3">
      <div class="card-header"><h6 class="card-title mb-0"><i class="fas fa-info-circle me-2"></i>Reservation Details</h6></div>
      <div class="card-body">
        <div class="row g-3">
          <div class="col-md-6">
            <table class="table table-sm table-borderless mb-0">
              <tr><th>Customer</th><td><a href="/crm/customers/<%= reservation.customer_id %>"><%= reservation.customer_name %></a></td></tr>
              <tr><th>Phone</th><td><%= reservation.customer_phone || '—' %></td></tr>
              <tr><th>Email</th><td><%= reservation.customer_email || '—' %></td></tr>
              <tr><th>Type</th><td><span class="badge bg-light text-dark"><%= reservation.reservation_type %></span></td></tr>
              <tr><th>Guests</th><td><%= reservation.num_guests %></td></tr>
              <tr><th>Source</th><td><%= reservation.source %></td></tr>
            </table>
          </div>
          <div class="col-md-6">
            <table class="table table-sm table-borderless mb-0">
              <% if (reservation.check_in_date) { %>
              <tr><th>Check-in</th><td><%= formatDate(reservation.check_in_date) %></td></tr>
              <tr><th>Check-out</th><td><%= formatDate(reservation.check_out_date) %></td></tr>
              <% } %>
              <% if (reservation.event_date) { %>
              <tr><th>Event Date</th><td><%= formatDate(reservation.event_date) %></td></tr>
              <tr><th>Time</th><td><%= reservation.start_time %> – <%= reservation.end_time %></td></tr>
              <% } %>
              <tr><th>Total Amount</th><td class="fw-bold text-primary"><%= formatPeso(reservation.total_amount) %></td></tr>
              <tr><th>Downpayment Req.</th><td class="fw-bold" style="color:#d97706;"><%= formatPeso(reservation.downpayment_req) %></td></tr>
              <tr><th>Amount Paid</th><td class="fw-bold text-success"><%= formatPeso(amountPaid) %></td></tr>
              <tr><th>Balance</th><td class="fw-bold <%= balance > 0 ? 'text-danger' : 'text-success' %>"><%= formatPeso(balance) %></td></tr>
            </table>
          </div>
          <% if (reservation.special_requests) { %>
          <div class="col-12">
            <div class="alert alert-info mb-0 py-2 small"><i class="fas fa-sticky-note me-1"></i><strong>Special Requests:</strong> <%= reservation.special_requests %></div>
          </div>
          <% } %>
        </div>
      </div>
    </div>

    <%# Booked Items %>
    <div class="card mb-3">
      <div class="card-header"><h6 class="card-title mb-0"><i class="fas fa-list me-2"></i>Booked Items</h6></div>
      <div class="card-body p-0">
        <table class="table table-sm mb-0">
          <thead><tr><th>Item</th><th>Type</th><th>Qty</th><th>Unit Price</th><th>Total</th></tr></thead>
          <tbody>
            <% if (!items || items.length === 0) { %>
            <tr><td colspan="5" class="text-center text-muted py-3">No items recorded.</td></tr>
            <% } else { %>
              <% for (const item of items) { %>
              <tr>
                <td><%= item.item_name || '—' %></td>
                <td><span class="badge bg-light text-dark small"><%= item.item_type %></span></td>
                <td><%= item.quantity %></td>
                <td><%= formatPeso(item.unit_price) %></td>
                <td class="fw-medium"><%= formatPeso(item.total_price) %></td>
              </tr>
              <% } %>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>

    <%# ── FIX 7: Customer Payment Proof Verification Panel ──────── %>
    <% const customerProofs = payments.filter(p => p.submitted_by === 'customer'); %>
    <% if (customerProofs && customerProofs.length > 0) { %>
    <div class="card mb-3 border-warning">
      <div class="card-header bg-warning bg-opacity-10">
        <h6 class="card-title mb-0 text-warning">
          <i class="fas fa-user-shield me-2"></i>Customer-Submitted Payment Proofs
          <% const unverifiedCount = customerProofs.filter(p => p.status === 'received').length; %>
          <% if (unverifiedCount > 0) { %>
          <span class="badge bg-warning text-dark ms-2"><%= unverifiedCount %> pending verification</span>
          <% } %>
        </h6>
      </div>
      <div class="card-body p-0">
        <% for (const p of customerProofs) { %>
        <div class="p-3 border-bottom">
          <div class="row g-2 align-items-start">
            <div class="col">
              <div class="d-flex flex-wrap gap-2 align-items-center mb-1">
                <strong class="small">₱<%= p.amount.toLocaleString('en-PH', {minimumFractionDigits:2}) %></strong>
                <span class="badge bg-light text-dark small"><%= p.payment_method.replace(/_/g,' ') %></span>
                <span class="badge bg-light text-dark small"><%= p.payment_type.replace(/_/g,' ') %></span>
                <% if (p.status === 'received') { %>
                  <span class="badge bg-warning text-dark"><i class="fas fa-clock me-1"></i>Pending Verification</span>
                <% } else if (p.status === 'verified') { %>
                  <span class="badge bg-success"><i class="fas fa-check me-1"></i>Verified</span>
                <% } else { %>
                  <span class="badge bg-danger"><i class="fas fa-times me-1"></i>Rejected</span>
                <% } %>
              </div>
              <div class="text-muted small">
                Submitted: <%= formatDateTime(p.created_at) %> &nbsp;&middot;&nbsp;
                Ref: <code class="small"><%= p.reference_number %></code>
              </div>
              <% if (p.notes) { %>
              <div class="text-muted small fst-italic mt-1"><%= p.notes %></div>
              <% } %>
              <% if (p.verified_at) { %>
              <div class="text-success small mt-1"><i class="fas fa-check-circle me-1"></i>Verified: <%= formatDateTime(p.verified_at) %></div>
              <% } %>
            </div>

            <%# Proof image %>
            <% if (p.proof_image) { %>
            <div class="col-auto">
              <a href="/portal/payment-proof/<%= p.id %>"
                 data-lightbox="/portal/payment-proof/<%= p.id %>"
                 data-lightbox-title="Payment Proof — <%= reservation.booking_ref %>"
                 style="cursor:zoom-in;text-decoration:none;">
                <img src="/portal/payment-proof/<%= p.id %>" alt="Payment Proof"
                  style="height:70px;width:90px;object-fit:cover;border-radius:.375rem;border:2px solid #e5e7eb;" />
                <div class="text-muted text-center" style="font-size:.68rem;"><i class="fas fa-search-plus me-1"></i>View Proof</div>
              </a>
            </div>
            <% } else { %>
            <div class="col-auto text-center text-muted small">
              <i class="fas fa-image fa-2x d-block mb-1" style="opacity:.25;"></i>No screenshot
            </div>
            <% } %>

            <%# Verify / Reject buttons (only for pending) %>
            <% if (p.status === 'received' && currentUser && (currentUser.role === 'admin' || currentUser.role === 'staff')) { %>
            <div class="col-auto d-flex flex-column gap-1">
              <form action="/reservations/<%= reservation.id %>/verify-payment/<%= p.id %>" method="POST">
                <input type="hidden" name="action" value="verify" />
                <button type="submit" class="btn btn-sm btn-success w-100"
                  data-confirm="Verify this ₱<%= p.amount.toLocaleString() %> payment and update the booking status?"
                  data-confirm-title="Verify Payment"
                  data-confirm-ok="Verify Payment">
                  <i class="fas fa-check me-1"></i>Verify
                </button>
              </form>
              <form action="/reservations/<%= reservation.id %>/verify-payment/<%= p.id %>" method="POST">
                <input type="hidden" name="action" value="reject" />
                <button type="submit" class="btn btn-sm btn-outline-danger w-100"
                  data-confirm="Reject this payment proof? The customer will need to resubmit."
                  data-confirm-title="Reject Payment"
                  data-confirm-type="danger"
                  data-confirm-ok="Reject">
                  <i class="fas fa-times me-1"></i>Reject
                </button>
              </form>
            </div>
            <% } %>
          </div>
        </div>
        <% } %>
      </div>
    </div>
    <% } %>

    <%# Payments (all) %>
    <div class="card mb-3">
      <div class="card-header d-flex justify-content-between align-items-center">
        <h6 class="card-title mb-0"><i class="fas fa-money-bill-wave me-2"></i>All Payments</h6>
        <% if (currentUser && (currentUser.role === 'admin' || currentUser.role === 'staff') && balance > 0) { %>
        <button class="btn btn-sm btn-success" data-bs-toggle="modal" data-bs-target="#paymentModal">
          <i class="fas fa-plus me-1"></i>Record Payment
        </button>
        <% } %>
      </div>
      <div class="card-body p-0">
        <table class="table table-sm mb-0">
          <thead><tr><th>Ref #</th><th>Amount</th><th>Method</th><th>Date</th><th>Type</th><th>Source</th><th>Status</th></tr></thead>
          <tbody>
            <% if (!payments || payments.length === 0) { %>
            <tr><td colspan="7" class="text-center text-muted py-3">No payments recorded yet.</td></tr>
            <% } else { %>
              <% for (const p of payments) { %>
              <tr class="<%= p.status === 'refunded' ? 'opacity-50' : '' %>">
                <td><code class="small"><%= p.reference_number %></code></td>
                <td class="fw-medium <%= p.status === 'refunded' ? 'text-muted' : 'text-success' %>">
                  <%= p.status === 'refunded' ? '—' : formatPeso(p.amount) %>
                </td>
                <td class="small"><%= p.payment_method.replace(/_/g,' ') %></td>
                <td class="small"><%= formatDate(p.payment_date) %></td>
                <td><span class="badge bg-light text-dark small"><%= p.payment_type.replace(/_/g,' ') %></span></td>
                <td>
                  <% if (p.submitted_by === 'customer') { %>
                  <span class="badge" style="background:#7c3aed;color:#fff;font-size:.65rem;">Customer</span>
                  <% } else { %>
                  <span class="badge bg-light text-dark" style="font-size:.65rem;">Staff</span>
                  <% } %>
                </td>
                <td><%- statusBadge(p.status) %></td>
              </tr>
              <% } %>
            <% } %>
          </tbody>
          <tfoot class="table-light">
            <tr><td colspan="6" class="text-end fw-bold">Total Paid:</td><td class="fw-bold text-success"><%= formatPeso(amountPaid) %></td></tr>
          </tfoot>
        </table>
      </div>
    </div>

    <%# Status History %>
    <div class="card">
      <div class="card-header"><h6 class="card-title mb-0"><i class="fas fa-history me-2"></i>Status History</h6></div>
      <div class="card-body">
        <div class="timeline">
          <% for (const sh of statusHistory) { %>
          <div class="timeline-item">
            <div class="timeline-dot"></div>
            <div class="timeline-content">
              <div class="d-flex align-items-center gap-2">
                <% if (sh.from_status) { %><%- statusBadge(sh.from_status) %><i class="fas fa-arrow-right text-muted small"></i><% } %>
                <%- statusBadge(sh.to_status) %>
              </div>
              <div class="small text-muted mt-1"><%= sh.changed_by_name || 'System' %> &mdash; <%= formatDateTime(sh.created_at) %></div>
              <% if (sh.notes) { %><div class="small text-muted fst-italic"><%= sh.notes %></div><% } %>
            </div>
          </div>
          <% } %>
        </div>
      </div>
    </div>

  </div>

  <%# ── Right column ────────────────────────────────────────────── %>
  <div class="col-lg-4">

    <%# Status Update %>
    <% if (currentUser && (currentUser.role === 'admin' || currentUser.role === 'staff')) { %>
    <%
      // A reservation is finished once it is completed, or the guest has already
      // checked out (checkout auto-completes the reservation). In that case we
      // show a read-only status instead of the manual dropdown.
      const isFinished = reservation.status === 'completed'
        || (guest && guest.status === 'checked_out')
        || !!checkOut;
    %>
    <div class="card mb-3">
      <div class="card-header"><h6 class="card-title mb-0"><i class="fas fa-exchange-alt me-2"></i>Booking Status</h6></div>
      <div class="card-body">
        <% if (isFinished) { %>
          <%# Read-only: the booking is completed — no manual status change needed %>
          <div class="text-center py-2">
            <div style="font-size:2rem;color:#10b981;"><i class="fas fa-check-circle"></i></div>
            <div class="fw-bold mt-1">Completed</div>
            <div class="text-muted small">The guest has checked out and this booking is complete.</div>
          </div>
        <% } else { %>
        <form action="/reservations/<%= reservation.id %>/status" method="POST">
          <div class="mb-2">
            <select name="status" class="form-select form-select-sm">
              <%#
                'completed' is intentionally omitted here — checkout happens via the
                "Check Out" button on the Guest card, which auto-completes the booking.
              %>
              <% for (const s of ['pending','awaiting_payment','confirmed','checked_in','cancelled','rejected','no_show']) { %>
              <option value="<%= s %>" <%= reservation.status === s ? 'selected' : '' %>>
                <%= s.replace(/_/g,' ').replace(/\b\w/g, l => l.toUpperCase()) %>
              </option>
              <% } %>
            </select>
          </div>
          <% if (balance > 0) { %>
          <div class="alert alert-warning py-2 small mb-2">
            <i class="fas fa-exclamation-triangle me-1"></i>
            Balance of <strong><%= formatPeso(balance) %></strong> must be collected before checkout.
          </div>
          <% } %>
          <div class="mb-2">
            <textarea name="notes" class="form-control form-control-sm" rows="2" placeholder="Notes (optional)..."></textarea>
          </div>
          <button type="submit" class="btn btn-sm btn-primary w-100">Update Status</button>
        </form>

        <%# ── Collect Remaining Balance (one click records the outstanding balance) ── %>
        <% if (balance > 0) { %>
        <form action="/reservations/<%= reservation.id %>/collect-balance" method="POST" class="mt-2">
          <label class="form-label small mb-1">Collect Remaining Balance</label>
          <div class="input-group input-group-sm mb-2">
            <span class="input-group-text">Method</span>
            <select name="payment_method" class="form-select">
              <% for (const m of ['cash','gcash','bank_transfer','maya','credit_card','check']) { %>
              <option value="<%= m %>"><%= m.replace(/_/g,' ').replace(/\b\w/g, l => l.toUpperCase()) %></option>
              <% } %>
            </select>
          </div>
          <button type="submit" class="btn btn-sm btn-success w-100"
            data-confirm="Record the full remaining balance of <%= formatPeso(balance) %> as paid? This marks the booking fully paid."
            data-confirm-title="Collect Remaining Balance"
            data-confirm-ok="Mark as Paid">
            <i class="fas fa-cash-register me-1"></i>Collect <%= formatPeso(balance) %> &amp; Mark Paid
          </button>
        </form>
        <% } %>
        <% } %>
      </div>
    </div>
    <% } %>

    <%# ── Refund Request Review (admin/staff) ──────────────────────── %>
    <% if (currentUser && (currentUser.role === 'admin' || currentUser.role === 'staff') && refundRequest) { %>
    <div class="card mb-3 border-warning">
      <div class="card-header bg-warning bg-opacity-10">
        <h6 class="card-title mb-0 text-warning"><i class="fas fa-hand-holding-usd me-2"></i>Refund Request</h6>
      </div>
      <div class="card-body">
        <div class="d-flex justify-content-between align-items-start mb-2">
          <div class="fw-bold text-danger"><%= formatPeso(refundRequest.amount) %></div>
          <% if (refundRequest.status === 'pending') { %><span class="badge bg-warning text-dark">Pending</span>
          <% } else if (refundRequest.status === 'approved') { %><span class="badge bg-success">Approved</span>
          <% } else { %><span class="badge bg-danger">Rejected</span><% } %>
        </div>
        <% if (refundRequest.reason) { %>
        <p class="small text-muted mb-2"><strong>Reason:</strong> <%= refundRequest.reason %></p>
        <% } %>
        <% if (refundRequest.gcash_number) { %>
        <p class="small text-muted mb-2"><strong>Refund to GCash:</strong> <code><%= refundRequest.gcash_number %></code></p>
        <% } %>
        <% if (refundRequest.status === 'pending') { %>
        <form action="/payments/refunds/requests/<%= refundRequest.id %>/review" method="POST" class="d-flex flex-column gap-2">
          <label class="form-label small mb-0">Payout Method</label>
          <select name="payout_method" class="form-select form-select-sm">
            <option value="gcash">GCash</option>
            <option value="cash">Cash</option>
            <option value="bank">Bank Transfer</option>
          </select>
          <input type="text" name="payout_ref" class="form-control form-control-sm" placeholder="Payout transaction reference (required for GCash/bank)" />
          <input type="text" name="admin_note" class="form-control form-control-sm" placeholder="Note / reason (required to reject)" />
          <div class="d-flex gap-2">
            <button type="submit" name="action" value="approve" class="btn btn-sm btn-success flex-fill"
              data-confirm="Approve this refund of <%= formatPeso(refundRequest.amount) %>? Make sure you have already sent the payout and entered its reference. This marks the booking refunded."
              data-confirm-title="Approve Refund" data-confirm-ok="Approve">
              <i class="fas fa-check me-1"></i>Approve
            </button>
            <button type="submit" name="action" value="reject" class="btn btn-sm btn-outline-danger flex-fill">
              <i class="fas fa-times me-1"></i>Reject
            </button>
          </div>
        </form>
        <a href="/payments/refunds/requests" class="d-block text-center small mt-2">View all refund requests</a>
        <% } else { %>
        <div class="small text-muted">
          <%= refundRequest.status === 'approved' ? 'Refund paid out.' : 'Request declined.' %>
          <% if (refundRequest.payout_method) { %><br />Method: <strong><%= refundRequest.payout_method.toUpperCase() %></strong><% } %>
          <% if (refundRequest.payout_ref) { %><br />Ref: <code><%= refundRequest.payout_ref %></code><% } %>
          <% if (refundRequest.admin_note) { %><br />Note: <%= refundRequest.admin_note %><% } %>
        </div>
        <% } %>
      </div>
    </div>
    <% } %>

    <%# Guest Info %>
    <% if (guest) { %>
    <div class="card mb-3">
      <div class="card-header"><h6 class="card-title mb-0"><i class="fas fa-user me-2"></i>Guest</h6></div>
      <div class="card-body">
        <div class="fw-medium"><%= guest.first_name %> <%= guest.last_name %></div>
        <div class="text-muted small"><%= guest.email || '' %></div>
        <div class="text-muted small"><%= guest.phone || '' %></div>
        <div class="mt-2"><%- statusBadge(guest.status) %></div>
        <% if (guest.status === 'checked_in') { %>
        <form action="/guests/<%= guest.id %>/checkout" method="POST" class="mt-2">
          <button type="submit" class="btn btn-sm btn-warning w-100"
            data-confirm="Confirm check-out for <%= guest.first_name %> <%= guest.last_name %>?"
            data-confirm-title="Guest Check-out"
            data-confirm-ok="Check Out">
            <i class="fas fa-sign-out-alt me-1"></i>Check Out
          </button>
        </form>
        <% } %>
      </div>
    </div>
    <% } %>

    <%# QR Code %>
    <% if (qrCode) { %>
    <div class="card mb-3">
      <div class="card-header"><h6 class="card-title mb-0"><i class="fas fa-qrcode me-2"></i>Check-in QR Code</h6></div>
      <div class="card-body text-center">
        <% if (qrCode.used) { %>
          <div class="alert alert-secondary py-2 small">This QR code has already been used.</div>
        <% } else { %>
          <img src="<%= qrCode.qr_path %>" alt="QR Code" class="img-fluid qr-img mb-2" />
          <div class="text-muted small">Guest can use this QR to check in</div>
        <% } %>
      </div>
    </div>
    <% } %>

  </div>
</div>

<%# ── Record Payment Modal ──────────────────────────────────────── %>
<div class="modal fade" id="paymentModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Record Payment</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <form action="/reservations/<%= reservation.id %>/payment" method="POST">
        <div class="modal-body">
          <div class="mb-3 p-3 bg-light rounded small">
            <strong>Total:</strong> <%= formatPeso(reservation.total_amount) %>
            &nbsp; <strong>Paid:</strong> <%= formatPeso(amountPaid) %>
            &nbsp; <strong>Balance:</strong> <span class="text-danger fw-bold"><%= formatPeso(balance) %></span>
          </div>
          <div class="mb-3">
            <label class="form-label required">Amount (₱)</label>
            <input type="number" name="amount" class="form-control"
              value="<%= Math.max(balance, reservation.downpayment_req || 0) %>"
              min="0.01" step="0.01" required />
          </div>
          <div class="mb-3">
            <label class="form-label required">Payment Method</label>
            <select name="payment_method" class="form-select">
              <% for (const m of ['cash','gcash','bank_transfer','maya','credit_card','check']) { %>
              <option value="<%= m %>"><%= m.replace(/_/g,' ').replace(/\b\w/g, l => l.toUpperCase()) %></option>
              <% } %>
            </select>
          </div>
          <div class="mb-3">
            <label class="form-label required">Payment Date</label>
            <input type="date" name="payment_date" class="form-control"
              value="<%= new Date().toISOString().slice(0,10) %>" required />
          </div>
          <div class="mb-3">
            <label class="form-label">Payment Type</label>
            <select name="payment_type" class="form-select">
              <option value="downpayment">Downpayment</option>
              <option value="balance" selected>Balance Payment</option>
              <option value="full_payment">Full Payment</option>
            </select>
          </div>
          <div class="mb-3">
            <label class="form-label">Notes / Reference</label>
            <input type="text" name="notes" class="form-control"
              placeholder="GCash ref, bank transaction ID, receipt #..." />
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-success">
            <i class="fas fa-save me-1"></i>Record Payment
          </button>
        </div>
      </form>
    </div>
  </div>
</div>
