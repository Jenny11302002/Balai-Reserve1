<% layout('layouts/main') %>

<div class="page-header">
  <div>
    <nav aria-label="breadcrumb"><ol class="breadcrumb mb-1"><li class="breadcrumb-item"><a href="/users">Users</a></li><li class="breadcrumb-item active"><%= user.first_name %> <%= user.last_name %></li></ol></nav>
    <h3 class="mb-0"><%= user.first_name %> <%= user.last_name %></h3>
  </div>
  <div class="page-header-actions">
    <%- statusBadge(user.is_active ? 'active' : 'inactive') %>
    <a href="/users/<%= user.id %>/edit" class="btn btn-sm btn-outline-secondary"><i class="fas fa-edit me-1"></i>Edit</a>
    <% if (user.id !== currentUser.id) { %>
    <form action="/users/<%= user.id %>/toggle" method="POST" class="d-inline">
      <button type="submit" class="btn btn-sm <%= user.is_active ? 'btn-outline-danger' : 'btn-outline-success' %>"
        data-confirm="<%= user.is_active ? 'Deactivate' : 'Activate' %> the account for <%= user.first_name %> <%= user.last_name %>?<%= user.is_active ? ' They will no longer be able to log in.' : ' They will regain login access.' %>"
        data-confirm-title="<%= user.is_active ? 'Deactivate User' : 'Activate User' %>"
        data-confirm-type="<%= user.is_active ? 'danger' : 'primary' %>"
        data-confirm-ok="<%= user.is_active ? 'Deactivate' : 'Activate' %>">
        <i class="fas fa-<%= user.is_active ? 'ban' : 'check' %> me-1"></i><%= user.is_active ? 'Deactivate' : 'Activate' %>
      </button>
    </form>
    <% } %>
  </div>
</div>

<div class="row g-3">
  <div class="col-lg-4">
    <div class="card">
      <div class="card-body text-center">
        <div class="user-avatar mx-auto mb-3" style="width:64px;height:64px;font-size:1.25rem;">
          <span><%= user.first_name.charAt(0) %><%= user.last_name.charAt(0) %></span>
        </div>
        <h6 class="fw-bold"><%= user.first_name %> <%= user.last_name %></h6>
        <div class="mb-3">
          <span class="badge <%= user.role_name === 'admin' ? 'bg-primary' : user.role_name === 'staff' ? 'bg-success' : 'bg-secondary' %>">
            <%= user.role_label %>
          </span>
        </div>
        <table class="table table-sm table-borderless text-start mb-0">
          <tr><th>Email</th><td class="small"><%= user.email %></td></tr>
          <tr><th>Phone</th><td class="small"><%= user.phone || '—' %></td></tr>
          <tr><th>Status</th><td><%- statusBadge(user.is_active ? 'active' : 'inactive') %></td></tr>
          <tr><th>Last Login</th><td class="small"><%= formatDateTime(user.last_login) || 'Never' %></td></tr>
          <tr><th>Created</th><td class="small"><%= formatDate(user.created_at) %></td></tr>
        </table>
      </div>
    </div>
  </div>
  <div class="col-lg-8">
    <div class="card">
      <div class="card-header"><h6 class="card-title mb-0"><i class="fas fa-history me-2"></i>Recent Activity (Audit Log)</h6></div>
      <div class="card-body p-0">
        <% if (!recentAudit || recentAudit.length === 0) { %>
        <div class="empty-state py-4"><i class="fas fa-history"></i><p>No recent activity recorded.</p></div>
        <% } else { %>
        <div class="table-responsive">
          <table class="table table-sm table-hover mb-0">
            <thead><tr><th>Action</th><th>Module</th><th>Date/Time</th></tr></thead>
            <tbody>
              <% for (const log of recentAudit) { %>
              <tr>
                <td class="small"><%= log.action.replace(/_/g,' ') %></td>
                <td><span class="badge bg-light text-dark small"><%= log.module %></span></td>
                <td class="small text-muted"><%= formatDateTime(log.created_at) %></td>
              </tr>
              <% } %>
            </tbody>
          </table>
        </div>
        <% } %>
      </div>
    </div>
  </div>
</div>
