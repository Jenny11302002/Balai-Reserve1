<% layout('layouts/main') %>
<div class="page-header"><div><nav aria-label="breadcrumb"><ol class="breadcrumb mb-1"><li class="breadcrumb-item"><a href="/venues">Venues</a></li><li class="breadcrumb-item active"><%= venue ? 'Edit Venue' : 'Add Venue' %></li></ol></nav><h3 class="mb-0"><%= venue ? 'Edit ' + venue.name : 'Add New Venue' %></h3></div></div>
<% if (errors && errors.length > 0) { %><div class="alert alert-danger"><% for (const e of errors) { %><div><i class="fas fa-exclamation-circle me-1"></i><%= e.msg %></div><% } %></div><% } %>
<div class="row"><div class="col-lg-7"><div class="card"><div class="card-body">
<form action="<%= venue ? '/venues/' + venue.id + '/edit' : '/venues' %>" method="POST">
  <div class="row g-3">
    <div class="col-md-8"><label class="form-label required">Venue Name</label><input type="text" name="name" class="form-control" value="<%= old.name || '' %>" required /></div>
    <div class="col-md-4"><label class="form-label required">Type</label><select name="venue_type" class="form-select" required><option value="">Select...</option><% for (const t of venueTypes) { %><option value="<%= t %>" <%= (old.venue_type || '') === t ? 'selected' : '' %>><%= t.replace(/_/g,' ') %></option><% } %></select></div>
    <div class="col-md-6"><label class="form-label required">Capacity</label><input type="number" name="capacity" class="form-control" value="<%= old.capacity || 50 %>" min="1" required /></div>
    <div class="col-md-6"><label class="form-label required">Price (₱)</label><div class="input-group"><span class="input-group-text">₱</span><input type="number" name="price" class="form-control" value="<%= old.price || '' %>" min="0" step="0.01" required /></div></div>
    <div class="col-md-6"><label class="form-label">Location</label><input type="text" name="location" class="form-control" value="<%= old.location || '' %>" placeholder="e.g. East Wing Garden" /></div>
    <div class="col-md-6"><label class="form-label">Status</label><select name="status" class="form-select"><% for (const s of ['available','reserved','maintenance','unavailable']) { %><option value="<%= s %>" <%= (old.status || 'available') === s ? 'selected' : '' %>><%= s %></option><% } %></select></div>
    <div class="col-12"><label class="form-label">Amenities <small class="text-muted">(comma-separated)</small></label><input type="text" name="amenities" class="form-control" value="<%= old.amenitiesStr || '' %>" placeholder="AC, Sound System, Projector..." /></div>
    <div class="col-12"><label class="form-label">Price Note</label><input type="text" name="price_note" class="form-control" value="<%= old.price_note || '' %>" placeholder="e.g. per event, includes setup" /></div>
    <div class="col-12"><label class="form-label">Description</label><textarea name="description" class="form-control" rows="3"><%= old.description || '' %></textarea></div>
  </div>
  <div class="d-flex gap-2 mt-4">
    <button type="submit" class="btn btn-primary"><i class="fas fa-save me-1"></i><%= venue ? 'Update Venue' : 'Create Venue' %></button>
    <a href="/venues<%= venue ? '/' + venue.id : '' %>" class="btn btn-outline-secondary">Cancel</a>
  </div>
</form>
</div></div></div></div>
