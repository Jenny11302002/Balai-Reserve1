<% layout('layouts/main') %>
<div class="page-header">
  <div><h3 class="mb-1">Venues</h3><p class="text-muted mb-0">Manage event venues and spaces</p></div>
  <div class="page-header-actions">
    <% if (currentUser && (currentUser.role === 'admin' || currentUser.role === 'staff')) { %>
    <a href="/venues/new" class="btn btn-sm btn-primary"><i class="fas fa-plus me-1"></i>Add Venue</a>
    <% } %>
  </div>
</div>
<div class="card mb-3">
  <div class="card-body py-2">
    <form method="GET" action="/venues" class="row g-2 align-items-end">
      <div class="col-12 col-md-4"><input type="text" name="search" value="<%= filters.search %>" class="form-control form-control-sm" placeholder="Search venues..." /></div>
      <div class="col-6 col-md-2"><select name="type" class="form-select form-select-sm"><option value="">All Types</option><% for (const t of venueTypes) { %><option value="<%= t %>" <%= filters.type === t ? 'selected' : '' %>><%= t.replace(/_/g,' ') %></option><% } %></select></div>
      <div class="col-6 col-md-2"><select name="status" class="form-select form-select-sm"><option value="">All Statuses</option><% for (const s of statuses) { %><option value="<%= s %>" <%= filters.status === s ? 'selected' : '' %>><%= s %></option><% } %></select></div>
      <div class="col-6 col-md-2"><button type="submit" class="btn btn-sm btn-primary w-100"><i class="fas fa-search"></i></button></div>
      <div class="col-6 col-md-2"><a href="/venues" class="btn btn-sm btn-outline-secondary w-100">Clear</a></div>
    </form>
  </div>
</div>
<div class="row g-3">
  <% if (!venues || venues.length === 0) { %>
  <div class="col-12"><div class="empty-state card"><i class="fas fa-map-marker-alt"></i><p>No venues found.</p></div></div>
  <% } else { %>
    <% for (const v of venues) { %>
    <div class="col-12 col-sm-6 col-lg-4">
      <div class="card h-100">
        <div class="card-body">
          <div class="d-flex justify-content-between mb-2">
            <span class="badge bg-primary text-white small"><%= v.venue_type.replace(/_/g,' ') %></span>
            <%- statusBadge(v.status) %>
          </div>
          <h6 class="fw-bold"><a href="/venues/<%= v.id %>"><%= v.name %></a></h6>
          <div class="text-muted small mb-2"><%= v.location || '' %></div>
          <div class="d-flex justify-content-between small">
            <span><i class="fas fa-users me-1 text-muted"></i><%= v.capacity %> capacity</span>
            <span class="fw-bold text-primary"><%= formatPeso(v.price) %></span>
          </div>
        </div>
        <div class="card-footer d-flex gap-2">
          <a href="/venues/<%= v.id %>" class="btn btn-sm btn-outline-primary flex-fill">View</a>
          <% if (currentUser && (currentUser.role === 'admin' || currentUser.role === 'staff')) { %>
          <a href="/venues/<%= v.id %>/edit" class="btn btn-sm btn-outline-secondary"><i class="fas fa-edit"></i></a>
          <% } %>
        </div>
      </div>
    </div>
    <% } %>
  <% } %>
</div>
<%include('partials/pagination')%>
